@inherits LayoutComponentBase

@* Required *@
<MudThemeProvider />
<MudPopoverProvider />
@* Needed for dialogs *@
<MudDialogProvider />
@* Needed for snackbars *@
<MudSnackbarProvider />
@* Needed for Dark Mode *@
<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" Theme="MyCustomTheme" />



<MudLayout>
    <MudAppBar>
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@((e) => DrawerToggle())" />
        <MudText Typo="Typo.h6" Class="ml-2">Attendance System</MudText>

        <MudSpacer />

        <MudToggleIconButton @bind-Toggled="@_isDarkMode"
                             Icon="@Icons.Material.Filled.DarkMode"
                             ToggledIcon="@Icons.Material.Filled.WbSunny"
                             Color="Color.Inherit"
                             ToggledColor="Color.Warning"
                             Class="mr-2" />
    </MudAppBar>

    <MudDrawer @bind-Open="@_drawerOpen">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="m-0 p-0">
        @Body
    </MudMainContent>
</MudLayout>
