@code {
    bool _drawerOpen = true;
    private bool _isDarkMode;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    MudTheme MyCustomTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            // Special cases (calendar-day.today)

            Dark = Colors.Gray.Lighten3,             // Hover states (#eeeeee)
            Primary = "#1976d2",                   // Material Blue 700
            Secondary = "#388e3c",                 // Material Green 700
            AppbarBackground = "#1565c0",          // Dark Blue 800
            Background = Colors.Gray.Lighten5,     // Light gray
            LinesDefault = Colors.Gray.Lighten2,     // Borders
            Surface = "#ffffff",                   // White cards
            TextPrimary = "rgba(0,0,0,0.87)",      // Standard text color
            TextSecondary = "rgba(0,0,0,0.6)",     // Secondary text
            ActionDefault = Colors.Blue.Lighten4,  // Light blue highlight (#bbdefb) (used for calendar highlights)
            Divider = Colors.Gray.Lighten2,        // For borders
            DrawerBackground = "#ffffff",          // Solid white drawer
            OverlayLight = "rgba(255,255,255,0.5)" // Light overlay
        },
        PaletteDark = new PaletteDark()
        {
            // Primary Colors
            Primary = Colors.Blue.Lighten1,         // Soft blue (#42a5f5)
            Secondary = Colors.Teal.Accent4,        // Vibrant teal
            AppbarBackground = "#0d47a1",           // Deep blue app bar

            // Backgrounds
            Background = "#121212",                 // Dark gray background
            Surface = "#1e1e1e",                    // Card surfaces
            DrawerBackground = "#1a1a1a",           // Slightly darker drawer

            // Text
            TextPrimary = "rgba(255,255,255,0.87)", // 87% white
            TextSecondary = "rgba(255,255,255,0.6)",// 60% white

            // UI Elements
            ActionDefault = Colors.Gray.Darken3,    // Today's highlight (#1565c0)
            Divider = "rgba(255,255,255,0.12)",     // Subtle borders
            OverlayDark = "rgba(0,0,0,0.7)",        // Dark overlays

            // States
            HoverOpacity = 0.08,                    // Subtle hover effects
            GrayDefault = "#757575"
            
        },

    };
}

