@inject NavigationManager Navigation

<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All">
        📅 Attendance System
    </MudNavLink>

    <!-- ✅ MudNavGroup with TitleContent and ChildContent -->
    <MudNavGroup Expanded="true" OnClick="@(() => Navigation.NavigateTo("/calendar"))">

        <!-- ✅ Custom title section with icon -->
        <TitleContent>
            <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Class="me-2" />
            Calendar Views
        </TitleContent>

        <!-- ✅ ChildContent wraps all submenu items -->
        <ChildContent>
            <MudNavLink Href="calendar/year" Match="NavLinkMatch.Prefix">
                <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Class="me-2" />
                Year View
            </MudNavLink>

            <MudNavLink Href="calendar/month" Match="NavLinkMatch.Prefix">
                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Class="me-2" />
                Month View
            </MudNavLink>

            <MudNavLink Href="@($"/calendar/day/{DateTime.Today:yyyy-MM-dd}")" Match="NavLinkMatch.Prefix">
                <MudIcon Icon="@Icons.Material.Filled.Today" Class="me-2" />
                Day View
            </MudNavLink>
        </ChildContent>

    </MudNavGroup>

    <!-- ✅ Attendance Import link -->
    <MudNavLink Href="/ImportAttendance" Match="NavLinkMatch.Prefix">
        <MudIcon Icon="@Icons.Material.Filled.FileUpload" Class="me-2" />
        Attendance Import
    </MudNavLink>

    <!-- ✅ Plan Attendance link -->
    <MudNavLink Href="/PlanAttendance" Match="NavLinkMatch.Prefix">
        <MudIcon Icon="@Icons.Material.Filled.EventNote" Class="me-2" />
        Plan Attendance
    </MudNavLink>

    <!-- ✅ Employees link -->
    <MudNavLink Href="/Employees" Match="NavLinkMatch.Prefix">
        <MudIcon Icon="@Icons.Material.Filled.People" Class="me-2" />
        Employees
    </MudNavLink>
</MudNavMenu>



