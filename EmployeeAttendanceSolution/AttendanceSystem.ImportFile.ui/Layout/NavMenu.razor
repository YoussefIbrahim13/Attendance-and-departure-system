<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand">📅 Attendance System</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        @{
            var navItems = new[]
            {
                new { Icon = "bi-calendar-event", Text = "Calendar", Href = "calendar", Match = NavLinkMatch.All },
                new { Icon = "bi-calendar4-range", Text = "Year View", Href = "calendar/year", Match = NavLinkMatch.Prefix },
                new { Icon = "bi-calendar3", Text = "Month View", Href = "calendar/month", Match = NavLinkMatch.Prefix },
                new { Icon = "bi-calendar-week", Text = "Day View", Href = $"/calendar/day/{DateTime.Today:yyyy-MM-dd}", Match = NavLinkMatch.Prefix },
                new { Icon = "bi-upload", Text = "Attendance Import", Href = "ImportAttendance", Match = NavLinkMatch.Prefix },
                new { Icon = "bi-people", Text = "Employees", Href = "Employees", Match = NavLinkMatch.Prefix },
                new { Icon = "bi-journal-check", Text = "Attendance Plan", Href = "PlanAttendance", Match = NavLinkMatch.Prefix }
            };

            foreach (var item in navItems)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link d-flex align-items-start" href="@item.Href" Match="@item.Match">
                        <span class="@item.Icon" aria-hidden="true"></span>
                        <span class="ms-1">@item.Text</span>
                    </NavLink>
                </div>
            }
        }
    </nav>
</div>