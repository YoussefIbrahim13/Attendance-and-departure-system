 @page "/calendar/month"
@page "/calendar/month/{Year:int}/{Month:int}"
@inject AttendanceSystem.ImportFile.ui.Services.AttendanceService AttendanceService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@using AttendanceSystem.ImportFile.ui.Services
@using EmployeesModels.Shared
@using MudBlazor



<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h4" Class="fw-bold">@GetMonthYearTitle()</MudText>
        <MudStack Row Spacing="2">
            <MudButtonGroup Variant="Variant.Outlined" Color="Color.Primary">
                <MudButton StartIcon="@Icons.Material.Filled.ChevronLeft" OnClick="PreviousMonth">
                    Previous
                </MudButton>
                <MudButton EndIcon="@Icons.Material.Filled.ChevronRight" OnClick="NextMonth">
                    Next
                </MudButton>
            </MudButtonGroup>
            <MudButton Variant="Variant.Filled" 
                      Color="Color.Primary" 
                      StartIcon="@Icons.Material.Filled.CalendarMonth" 
                      OnClick="GoToYearView">
                Year View
            </MudButton>
        </MudStack>
    </MudStack>

    @if (isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="mt-8">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            <MudText Typo="Typo.body1">Loading...</MudText>
        </MudStack>
    }
    else if (monthData != null)
    {
        <MudPaper Elevation="2" Class="calendar-container">
            <!-- Calendar Header -->
            <MudStack Row Class="calendar-header">
                <MudPaper Class="calendar-day-header" Square="true" Elevation="0">
                    <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="fw-bold">Sunday</MudText>
                </MudPaper>
                <MudPaper Class="calendar-day-header" Square="true" Elevation="0">
                    <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="fw-bold">Monday</MudText>
                </MudPaper>
                <MudPaper Class="calendar-day-header" Square="true" Elevation="0">
                    <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="fw-bold">Tuesday</MudText>
                </MudPaper>
                <MudPaper Class="calendar-day-header" Square="true" Elevation="0">
                    <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="fw-bold">Wednesday</MudText>
                </MudPaper>
                <MudPaper Class="calendar-day-header" Square="true" Elevation="0">
                    <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="fw-bold">Thursday</MudText>
                </MudPaper>
                <MudPaper Class="calendar-day-header" Square="true" Elevation="0">
                    <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="fw-bold">Friday</MudText>
                </MudPaper>
                <MudPaper Class="calendar-day-header" Square="true" Elevation="0">
                    <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="fw-bold">Saturday</MudText>
                </MudPaper>
            </MudStack>

            <!-- Calendar Body -->
            <div class="calendar-body">
                @{
                    var firstDayOfMonth = new DateTime(currentYear, currentMonth, 1);
                    int diff = ((int)firstDayOfMonth.DayOfWeek + 7) % 7; // ensures Sunday = 0
                    var startDate = firstDayOfMonth.AddDays(-diff);
                    var endDate = startDate.AddDays(41); // 6 weeks
                }

                @for (var date = startDate; date <= endDate; date = date.AddDays(1))
                {
                    var currentDate = date; // Create a local copy to avoid closure issues
                    var dayData = monthData.Days.FirstOrDefault(d => d.Date.Date == currentDate.Date);
                    var isCurrentMonth = currentDate.Month == currentMonth;
                    var isToday = currentDate.Date == DateTime.Today;

                    <MudPaper Class="@GetCalendarDayClass(isCurrentMonth, isToday)" 
                             Square="true" 
                             Elevation="@(isCurrentMonth ? 1 : 0)"
                             @ondblclick="() => { if (isCurrentMonth) GoToDayView(currentDate); }">

                        <MudStack Justify="Justify.SpaceBetween" Style="height: 100%; min-height: 120px;">
                            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.subtitle2" Class="fw-bold">@currentDate.Day</MudText>
                                @if (isCurrentMonth)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Add" 
                                                  Size="Size.Small" 
                                                  Color="Color.Primary" 
                                                  Variant="Variant.Filled"
                                                  Style="width: 24px; height: 24px;"
                                                  OnClick="() => OpenAddEmployeeDialog(currentDate)" />
                                }
                            </MudStack>

                            @if (dayData != null && isCurrentMonth)
                            {
                                <MudStack Spacing="1" Class="day-content">
                                    <MudStack Row Justify="Justify.SpaceBetween" Class="attendance-summary">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">
                                            Present: @dayData.PresentCount
                                        </MudChip>
                                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text">
                                            Absent: @dayData.AbsentCount
                                        </MudChip>
                                    </MudStack>

                                    <MudStack Spacing="1" Class="employee-preview">
                                        @foreach (var emp in dayData.TopEmployees.Take(3))
                                        {
                                            <MudPaper Class="@GetEmployeeStatusClass(emp.Status)" Square="true" Elevation="0">
                                                <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pa-1">
                                                    <MudText Typo="Typo.caption" Class="employee-name">@emp.EmployeeName</MudText>
                                                    <div class="status-indicator @GetStatusIndicatorClass(emp.Status)"></div>
                                                </MudStack>
                                            </MudPaper>
                                        }
                                        @if (dayData.TotalEmployees > 3)
                                        {
                                            <MudText Typo="Typo.caption" Align="Align.Center" Class="more-employees">
                                                +@(dayData.TotalEmployees - 3) more
                                            </MudText>
                                        }
                                    </MudStack>
                                </MudStack>
                            }
                        </MudStack>
                    </MudPaper>
                }
            </div>
        </MudPaper>
    }
</MudContainer>

<style>
    .calendar-container {
        border-radius: 8px;
        overflow: hidden;
    }

    .calendar-header {
        background: var(--mud-palette-surface);
        border-bottom: 2px solid var(--mud-palette-divider);
        margin: 0 -8px; /* Counteract container padding */
        padding: 0 8px; /* Match container padding */
    }

    .calendar-day-header {
        padding: 15px 10px;
        flex: 1;
        background: var(--mud-palette-surface);
        border-right: 1px solid var(--mud-palette-divider);
    }

    .calendar-day-header:last-child {
