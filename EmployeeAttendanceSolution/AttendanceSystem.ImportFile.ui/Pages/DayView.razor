@page "/calendar/day"
@page "/calendar/day/{DateString}"
@inject AttendanceSystem.ImportFile.ui.Services.AttendanceService AttendanceService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@using AttendanceSystem.ImportFile.ui.Services
@using EmployeesModels.Shared

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <!-- ✅ HEADER -->
    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h4" Class="fw-bold">@GetDateTitle()</MudText>
        <MudStack Row Spacing="2">
            <MudButtonGroup Variant="Variant.Outlined" Color="Color.Primary">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="PreviousDay" StartIcon="@Icons.Material.Filled.ChevronLeft">
                    Previous Day
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="NextDay" EndIcon="@Icons.Material.Filled.ChevronRight">
                    Next Day
                </MudButton>
            </MudButtonGroup>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GoToMonthView" StartIcon="@Icons.Material.Filled.CalendarToday">
                Month View
            </MudButton>
        </MudStack>
    </MudStack>
    @if (isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="mt-8">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            <MudText Typo="Typo.body1">Loading...</MudText>
        </MudStack>
    }
    else if (dayData.Any())
    {
        <!-- ✅ SUMMARY CARDS -->
        <MudGrid Class="mb-4" Gutter="3">
            @SummaryCard("Present", AttendanceStatus.Present, Icons.Material.Filled.CheckCircle, "present")
            @SummaryCard("Absent", AttendanceStatus.Absent, Icons.Material.Filled.Cancel, "absent")
            @SummaryCard("Vacation", AttendanceStatus.Vacation, Icons.Material.Filled.CalendarToday, "vacation")
            @SummaryCard("Work From Home", AttendanceStatus.WorkFromHome, Icons.Material.Filled.Home, "wfh")
        </MudGrid>

        <!-- ✅ FILTERS -->
        <MudGrid Class="mb-4" Spacing="2" Style="align-items: center;">
            <MudItem xs="12" sm="6" Style="height: 72px; display: flex; align-items: center;">
                <MudTextField @bind-Value="searchTerm"
                              Immediate="true"
                              Variant="Variant.Outlined"
                              Placeholder="Search employees..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Style="width: 100%;"
                              TextChanged="@(e => { searchTerm = e.ToString(); FilterEmployees(); })" />
            </MudItem>
            <MudItem xs="12" sm="6" Style="height: 72px;">
                <MudSelect T="string"
                           @bind-Value="selectedStatusString"
                           Immediate="true"
                           Variant="Variant.Outlined"
                           Label="Filter by Status"
                           Style="width: 100%;">
                    <MudSelectItem Value="string.Empty">All Statuses</MudSelectItem>
                    @foreach (var status in Enum.GetValues(typeof(AttendanceStatus)))
                    {
                        <MudSelectItem Value="@status.ToString()">@status.ToString()</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>

        <!-- ✅ EMPLOYEE TABLE (Editable) -->
        <MudCard>
            <MudCardHeader>
                <MudText Typo="Typo.h5" Class="mb-0">Employee Attendance Details (@filteredEmployees.Count employees)</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudDataGrid T="DailyAttendanceDto"
                             Items="@filteredEmployees"
                             ReadOnly="@_readOnly"
                             EditMode="@(_isCellEditMode ? DataGridEditMode.Cell : DataGridEditMode.Form)"
                             StartedEditingItem="@StartedEditingItem"
                             CanceledEditingItem="@CanceledEditingItem"
                             CommittedItemChanges="@CommittedItemChanges"
                             Bordered="true"
                             Dense="true"
                             EditTrigger="@(_editTriggerRowClick ? DataGridEditTrigger.OnRowClick : DataGridEditTrigger.Manual)">

                    <Columns>
                        <div class="d-flex align-center" style="height:64px;"> <!-- Match Avatar column height -->
                        <PropertyColumn Property="x => x.EmployeeName" Title="Employee" Editable="false">
                                
                            <CellTemplate>
                                <MudStack Items="Items.Center" Gap="8">
                                    <MudAvatar Class="employee-avatar">@GetInitials(context.Item.EmployeeName)</MudAvatar>
                                    <MudStack>
                                        <MudText Class="employee-name">@context.Item.EmployeeName</MudText>
                                        <MudText Color="Color.Secondary" Typo="Typo.caption">ID: @context.Item.EmployeeId</MudText>
                                    </MudStack>
                                </MudStack>
                                
                            </CellTemplate>
                        </PropertyColumn>

                        <PropertyColumn Property="x => x.Department" Title="Department" Editable="false" />

                        <PropertyColumn Property="x => x.Status" Title="Status">
                            <CellTemplate>
                                <MudChip T="string" Class="@($"status-badge {GetStatusClass(context.Item.Status)}")"
                                         Variant="Variant.Filled" Size="Size.Small">
                                    @GetStatusIcon(context.Item.Status) @context.Item.Status
                                </MudChip>
                            </CellTemplate>
                            <EditTemplate>
                                 <MudSelect @bind-Value="context.Item.Status"
                                           Label="Status"
                                           Variant="Variant.Outlined"
                                           Required="true"
                                           RequiredError="Status is required">
                                    <MudSelectItem Value="@AttendanceStatus.Present">
                                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                            <div class="status-indicator present"></div>
                                            <MudText>Present</MudText>
                                        </MudStack>
                                    </MudSelectItem>
                                    <MudSelectItem Value="@AttendanceStatus.Absent">
                                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                            <div class="status-indicator absent"></div>
                                            <MudText>Absent</MudText>
                                        </MudStack>
                                    </MudSelectItem>
                                    <MudSelectItem Value="@AttendanceStatus.Vacation">
                                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                            <div class="status-indicator vacation"></div>
                                            <MudText>Vacation</MudText>
                                        </MudStack>
                                    </MudSelectItem>
                                    <MudSelectItem Value="@AttendanceStatus.WorkFromHome">
                                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                            <div class="status-indicator work-from-home"></div>
                                            <MudText>Work From Home</MudText>
                                        </MudStack>
                                    </MudSelectItem>
                                </MudSelect> 
                            </EditTemplate>
                        </PropertyColumn>

                            <PropertyColumn Property="x => x.CheckIn" Title="Check In">
                                <CellTemplate>
                                    <span>@FormatTimeSpan(context.Item.CheckIn)</span>
                                </CellTemplate>
                                <EditTemplate>
                                    <MudTimePicker Label="Check-in"
                                                   Time="context.Item.CheckIn"
                                                   TimeChanged="newTime => OnCheckInChanged(newTime, context.Item)"
                                                   TimeFormat="HH:mm"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   Editable="true"
                                                   Tooltip="Select check-in time"
                                                   AnchorOrigin="Origin.TopCenter"
                                                   TransformOrigin="Origin.BottomCenter" />
                                </EditTemplate>
                            </PropertyColumn>

                            <PropertyColumn Property="x => x.CheckOut" Title="Check Out">
                                <CellTemplate>
                                    <span>@FormatTimeSpan(context.Item.CheckOut)</span>
                                </CellTemplate>
                                <EditTemplate>
                                    <MudTimePicker Label="Check-out"
                                                   Time="context.Item.CheckOut"
                                                   TimeChanged="newTime => OnCheckOutChanged(newTime, context.Item)"
                                                   TimeFormat="HH:mm"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   Editable="true"
                                                   Tooltip="Select check-out time"
                                                   AnchorOrigin="Origin.TopCenter"
                                                   TransformOrigin="Origin.BottomCenter" />
@code {
    void OnCheckInChanged(TimeSpan? newTime, DailyAttendanceDto item)
    {
        item.CheckIn = newTime ?? TimeSpan.Zero;
    }
    void OnCheckOutChanged(TimeSpan? newTime, DailyAttendanceDto item)
    {
        item.CheckOut = newTime ?? TimeSpan.Zero;
    }
}
                                </EditTemplate>
                            </PropertyColumn>

                        <PropertyColumn Property="x => x.Note" Title="Notes">
                            <EditTemplate>
                                <MudTextField @bind-Value="context.Item.Note" Margin="Margin.Dense" />
                            </EditTemplate>
                        </PropertyColumn>

                        <TemplateColumn Hidden="@(_isCellEditMode || _readOnly || _editTriggerRowClick)" CellClass="d-flex justify-end">
                            <CellTemplate>
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@context.Actions.StartEditingItemAsync" />
                            </CellTemplate>
                        </TemplateColumn>
                        </div>
                    </Columns>
                </MudDataGrid>
            </MudCardContent>
        </MudCard>

        <!-- ✅ EDITING CONTROLS -->
        <div class="d-flex flex-wrap mt-4">
            <MudSwitch @bind-Value="_readOnly" Color="Color.Primary">Read Only</MudSwitch>
            <div class="d-flex justify-start align-center ml-4">
                <p class="mud-typography mud-typography-body1 mud-inherit-text mr-2">Form</p>
                <MudSwitch @bind-Value="_isCellEditMode" Color="Color.Primary">Cell</MudSwitch>
            </div>
            <div class="d-flex justify-start align-center ml-4">
                <p class="mud-typography mud-typography-body1 mud-inherit-text mr-2">Manual</p>
                <MudSwitch @bind-Value="_editTriggerRowClick" Color="Color.Primary">On Row Click</MudSwitch>
            </div>
        </div>
    }
</MudContainer>


