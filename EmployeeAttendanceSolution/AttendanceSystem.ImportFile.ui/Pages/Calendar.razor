@page "/"
@page "/calendar"
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.False" Class="m-0 p-0" Style="min-height: calc(100vh - 64px);">

    <MudGrid Justify="Justify.Center">
        <MudItem xs="12" Class="text-center mb-5">
            <MudText Typo="Typo.h3"  Class="fw-bold mb-2">
                Employee Attendance Calendar
            </MudText>
            <MudText Typo="Typo.subtitle1" >
                Manage and view employee attendance across different time periods
            </MudText>
        </MudItem>
    </MudGrid>

    <!-- Cards Section -->
    <MudGrid Justify="Justify.Center" Spacing="3" >
        <!-- Month View Card -->
        <MudItem md="4" Class="h-100" Style="min-height: 400px;">
            <MudCard Elevation="3" ElevationHover="5" Class="calendar-option-card h-100" Style="text-align:center; transition: all 0.3s ease;">
                <MudCardContent>
                    <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Color="Color.Primary" Size="Size.Large" Class="mb-2" />
                    <MudText Typo="Typo.h5" Class="mb-1">Month View</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Primary">
                        View daily attendance in a monthly calendar with employee status at a glance. Double-click a day for details.
                    </MudText>
                    <MudList T="string" Dense="true" Class="mt-3">
                        <MudListItem>
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" Class="me-1" />
                            Daily attendance overview
                        </MudListItem>
                        <MudListItem>
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" Class="me-1" />
                            Employee status indicators
                        </MudListItem>
                        <MudListItem>
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" Class="me-1" />
                            Quick navigation
                        </MudListItem>
                    </MudList>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" OnClick="GoToMonthView">
                        Open Month View
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- Year View Card -->
        <MudItem md="4" Class="h-100">
            <MudCard Elevation="3" ElevationHover="5" Class="calendar-option-card h-100" Style="text-align:center; transition: all 0.3s ease;">
                <MudCardContent>
                    <MudIcon Icon="@Icons.Material.Filled.DateRange" Color="Color.Primary" Size="Size.Large" Class="mb-2" />
                    <MudText Typo="Typo.h5" Class="mb-1">Year View</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Primary">
                        Browse through months in a year. Click on any month to jump directly to that month's detailed view.
                    </MudText>
                    <MudList T="string" Dense="true" Class="mt-3">
                        <MudListItem>
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" Class="me-1" />
                            Daily attendance overview
                        </MudListItem>
                        <MudListItem>
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" Class="me-1" />
                            Employee status indicators
                        </MudListItem>
                        <MudListItem>
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" Class="me-1" />
                            Quick navigation
                        </MudListItem>
                    </MudList>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" OnClick="GoToYearView">
                        Open Year View
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- Day View Card -->
        <MudItem md="4" Class="h-100">
            <MudCard Elevation="3" ElevationHover="5" Class="calendar-option-card h-100" Style="text-align:center; transition: all 0.3s ease;">
                <MudCardContent>
                    <MudIcon Icon="@Icons.Material.Filled.Today" Color="Color.Primary" Size="Size.Large" Class="mb-2" />
                    <MudText Typo="Typo.h5" Class="mb-1">Day View</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Primary">
                        Detailed view of all employees' attendance for a specific day. See check-in/out times, working hours, and notes.
                    </MudText>
                    <MudList T="string" Dense="true" Class="mt-3">
                        <MudListItem>
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" Class="me-1" />
                            Daily attendance overview
                        </MudListItem>
                        <MudListItem>
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" Class="me-1" />
                            Employee status indicators
                        </MudListItem>
                        <MudListItem>
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" Class="me-1" />
                            Quick navigation
                        </MudListItem>
                    </MudList>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" OnClick="GoToTodayView">
                        View Today
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>


    <!-- Quick Actions -->
    <MudStack Row="true" Spacing="2" Justify="Justify.Center" AlignItems="AlignItems.Center" Wrap="Wrap.NoWrap">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="rounded-pill px-4 py-2 d-flex align-items-center" Style="min-height:48px;" OnClick="GoToCurrentMonth">
            <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Class="me-2" />
            Current Month
        </MudButton>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="rounded-pill px-4 py-2 d-flex align-items-center" Style="min-height:48px;" OnClick="GoToCurrentYear">
            <MudIcon Icon="@Icons.Material.Filled.DateRange" Class="me-2" />
            Current Year
        </MudButton>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="rounded-pill px-4 py-2 d-flex align-items-center" Style="min-height:48px;" OnClick="GoToToday">
            <MudIcon Icon="@Icons.Material.Filled.Today" Class="me-2" />
            Today
        </MudButton>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="rounded-pill px-4 py-2 d-flex align-items-center" Style="min-height:48px;" OnClick="GoToImport">
            <MudIcon Icon="@Icons.Material.Filled.Upload" Class="me-2" />
            Import Attendance
        </MudButton>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="rounded-pill px-4 py-2 d-flex align-items-center" Style="min-height:48px;" OnClick="@(() => Navigation.NavigateTo("/planattendance"))">
            <MudIcon Icon="@Icons.Material.Filled.EventNote" Class="me-2" />
            Plan Attendance
        </MudButton>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="rounded-pill px-4 py-2 d-flex align-items-center" Style="min-height:48px;" OnClick="@(() => Navigation.NavigateTo("/employees"))">
            <MudIcon Icon="@Icons.Material.Filled.Group" Class="me-2" />
            Employees
        </MudButton>
    </MudStack>

</MudContainer>


@code {
    private string hoverClass = "";
    private void GoToMonthView() => Navigation.NavigateTo($"/calendar/month/{DateTime.Today.Year}/{DateTime.Today.Month}");
    private void GoToYearView() => Navigation.NavigateTo($"/calendar/year/{DateTime.Today.Year}");
    private void GoToTodayView() => Navigation.NavigateTo($"/calendar/day/{DateTime.Today:yyyy-MM-dd}");
    private void GoToCurrentMonth() => Navigation.NavigateTo($"/calendar/month/{DateTime.Today.Year}/{DateTime.Today.Month}");
    private void GoToCurrentYear() => Navigation.NavigateTo($"/calendar/year/{DateTime.Today.Year}");
    private void GoToToday() => Navigation.NavigateTo($"/calendar/day/{DateTime.Today:yyyy-MM-dd}");
    private void GoToImport() => Navigation.NavigateTo("/ImportAttendance");
   
   
}

<style>
    .calendar-option-card:hover {
        transform: translateY(-5px) !important;
        box-shadow: 0 8px 25px rgba(0,0,0,0.15) !important;
    }

    .current-month {
        background: linear-gradient(135deg, #f8fff9 0%, #ffffff 100%) !important;
    }
</style>