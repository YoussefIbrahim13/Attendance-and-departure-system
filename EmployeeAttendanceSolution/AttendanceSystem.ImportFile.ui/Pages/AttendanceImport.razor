
@page "/ImportAttendance"


@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject AttendanceSystem.ImportFile.ui.Services.AttendanceService AttendanceService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@using AttendanceSystem.ImportFile.ui.Services
@using MudBlazor
@using EmployeesModels.Shared
@using Microsoft.AspNetCore.Components.Forms


@attribute [Authorize(Roles = "Admin")]
<AuthorizeView Roles="Admin">
    <Authorized>
<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-10 d-flex justify-center align-center" Style="min-height:90vh;">
    <MudPaper Class="pa-10" Elevation="12" Style="
        border-radius:32px;
        min-width:440px;
        background: var(--mud-palette-surface);
        box-shadow: 0 12px 40px 0 rgba(31, 38, 135, 0.13), 0 1.5px 8px 0 rgba(25, 118, 210, 0.10);
        backdrop-filter: blur(12px) saturate(120%);
        border: 1.5px solid rgba(25, 118, 210, 0.10);
        ">
        <MudText Typo="Typo.h2" Align="Align.Center" Class="mb-6 fw-bold" Style="letter-spacing:2.5px; color:#1976d2; text-shadow:0 4px 16px #e3f2fd, 0 1px 0 #fff; font-family:'Segoe UI',Roboto,sans-serif;">
            <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Large" Class="me-2" Style="vertical-align:middle; color:#90caf9; filter:drop-shadow(0 2px 8px #1976d2aa);" />
            Attendance Import
        </MudText>
        <MudStack Row Spacing="2" AlignItems="AlignItems.Center" JustifyContent="Justify.Center" Class="mb-6">
            <MudTextField T="string" ReadOnly="true" Value="@(selectedFile?.Name ?? "No file selected")" Style="width:220px;" />
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="TriggerFileInput">
                <MudIcon Icon="@Icons.Material.Filled.UploadFile" Class="me-2" />Upload File
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(selectedFile == null)" OnClick="UploadFile">
                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Class="me-2" />Process
            </MudButton>
        </MudStack>
        <InputFile id="file-upload-input" OnChange="OnFileChange" style="display:none" />
@code {
    async Task TriggerFileInput()
    {
        await JS.InvokeVoidAsync("triggerFileInput", "file-upload-input");
    }
}
        <!-- الرسائل ستظهر عبر Snackbar -->

        @if (pendingAttendance != null)
        {
            <MudPaper Class="pa-4 mt-4" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-3">Pending Attendance Data</MudText>
                <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                    <MudTextField @bind-Value="searchId" Label="Search by Employee ID" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:200px;" />
                    <MudSelect T="SortColumn" @bind-Value="selectedSortColumn" Label="Sort Column" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:140px;">
                        <MudSelectItem Value="SortColumn.EmployeeId">Employee ID</MudSelectItem>
                        <MudSelectItem Value="SortColumn.Date">Date</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="SortDirection" @bind-Value="selectedSortDirection" Label="Direction" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:120px;">
                        <MudSelectItem Value="SortDirection.Ascending">Ascending</MudSelectItem>
                        <MudSelectItem Value="SortDirection.Descending">Descending</MudSelectItem>
                    </MudSelect>
                    <MudTooltip Text="Sort Data">
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="ApplySortAsync" Class="ml-2" Disabled="@isSorting" Style="border-radius:24px; min-width:48px; min-height:40px; box-shadow:0 2px 8px #1976d233;">
                            @if (isSorting)
                            {
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Info" Style="width:22px;height:22px;" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Sort" Size="Size.Medium" />
                            }
                        </MudButton>
                    </MudTooltip>
                </MudStack>
                <MudTable Items="@filteredAttendance" Hover="true" Bordered="true" Striped="true" Dense="true">
                    <HeaderContent>
                        <MudTh>Employee Code</MudTh>
                        <MudTh Style="min-width:120px;">Date</MudTh>
                        <MudTh>Check In</MudTh>
                        <MudTh>Check Out</MudTh>
                        <MudTh>Actual Status</MudTh>
                        <MudTh>Approval Status</MudTh>
                        <MudTh>Note</MudTh>
                        <MudTh>Edit</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="row">
                        <MudTd DataLabel="Employee ID">@row.Code</MudTd>
                        <MudTd DataLabel="Date">
                            @{
                                string? dateStr = row.Date.ToString();
                                if (!string.IsNullOrEmpty(dateStr) && DateTime.TryParse(dateStr, out var dt))
                                {
                                    @dt.ToString("yyyy-MM-dd")
                                }
                                else if (!string.IsNullOrEmpty(dateStr) && dateStr.Contains("T"))
                                {
                                    @dateStr.Split('T')[0]
                                }
                                else
                                {
                                    @dateStr
                                }
                            }
                        </MudTd>
                        <MudTd DataLabel="Check In">
                            @if (editRow == row)
                            {
                                <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                    <MudTimePicker 
                                        Label="Check-in"
                                        Time="@editCheckInTime"
                                        TimeChanged="(t) => editCheckInTime = t ?? TimeSpan.Zero"
                                        TimeFormat="HH:mm"
                                        Variant="Variant.Outlined"
                                        Margin="Margin.Dense"
                                        Editable="true"
                                        Tooltip="Select check-in time"
                                        AnchorOrigin="Origin.TopCenter"
                                        TransformOrigin="Origin.BottomCenter"
                                    />
                                    <MudText Typo="Typo.body2" Class="ml-2">@editCheckInTime.ToString(@"hh\:mm")</MudText>
                                </MudStack>
                            }
                            else
                            {
                                @row.CheckIn.ToString(@"hh\:mm")
                            }
                        </MudTd>
                        <MudTd DataLabel="Check Out">
                            @if (editRow == row)
                            {
                                <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                    <MudTimePicker 
                                        Label="Check-out"
                                        Time="@editCheckOutTime"
                                        TimeChanged="(t) => editCheckOutTime = t ?? TimeSpan.Zero"
                                        TimeFormat="HH:mm"
                                        Variant="Variant.Outlined"
                                        Margin="Margin.Dense"
                                        Editable="true"
                                        Tooltip="Select check-out time"
                                        AnchorOrigin="Origin.TopCenter"
                                        TransformOrigin="Origin.BottomCenter"
                                    />
                                    <MudText Typo="Typo.body2" Class="ml-2">@editCheckOutTime.ToString(@"hh\:mm")</MudText>
                                </MudStack>
                            }
                            else
                            {
                                @row.CheckOut.ToString(@"hh\:mm")
                            }
                        </MudTd>
                        <MudTd DataLabel="Actual Status">
                            @if (editRow == row)
                            {
                                <MudSelect T="AttendanceStatus" @bind-Value="editStatusValue" Dense="true" Style="width:120px;">
                                    @foreach (var status in Enum.GetValues<AttendanceStatus>())
                                    {
                                        <MudSelectItem Value="@status">@status</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            else
                            {
                                @row.ActualStatus
                            }
                        </MudTd>
                        <MudTd DataLabel="Approval Status">
                            @if (editRow == row)
                            {
                                <MudSelect T="ApprovalStatus" @bind-Value="editApprovalStatus" Dense="true" Style="width:120px;">
                                    <MudSelectItem Value="@ApprovalStatus.Pending">Pending</MudSelectItem>
                                    <MudSelectItem Value="@ApprovalStatus.Approved">Approved</MudSelectItem>
                                </MudSelect>
                            }
                            else
                            {
                                @row.ApprovalStatus
                            }
                        </MudTd>
                        <MudTd DataLabel="Note">
                            @if (editRow == row)
                            {
                                <MudTextField T="string" @bind-Value="editNote" Dense="true" />
                            }
                            else
                            {
                                @row.Note
                            }
                        </MudTd>
                        <MudTd DataLabel="Edit">
                            @if (editRow == row)
                            {
                                <MudStack Row Spacing="1">
                                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" OnClick="() => SaveEdit(row)" Style="min-width:70px;">SAVE</MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" OnClick="CancelEdit" Style="min-width:70px;">CANCEL</MudButton>
                                </MudStack>
                            }
                            else
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="() => StartEdit(row)">Edit</MudButton>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
                <MudStack Row JustifyContent="Justify.Center" Class="mt-4">
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" Color="Color.Info" Size="Size.Small" OnClick="SaveAll" Disabled="@isSavingAll" Loading="@isSavingAll">
                        Save
                    </MudButton>
                </MudStack>
            </MudPaper>
        }
    </MudPaper>
</MudContainer>
</Authorized>
</AuthorizeView>