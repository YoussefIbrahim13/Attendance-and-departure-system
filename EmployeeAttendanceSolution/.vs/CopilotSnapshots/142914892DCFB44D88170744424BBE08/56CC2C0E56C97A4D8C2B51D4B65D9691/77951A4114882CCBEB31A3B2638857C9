using Applications.Abstractions;
using Applications.CSVFile.DTOS.AttendanceRecord;
using Domain.Entities;
using System.Windows.Input;
using MediatR;
using static System.Runtime.InteropServices.JavaScript.JSType;

namespace Applications.CSVFile.Commandss.EditPendingAttendance;

public class EditPendingAttendanceCommand: IRequest<string>
{
    public List<AttendanceRecord> PendingAttendance { get; }
    public EditAttendanceRecordDto Dto { get; }
    public string Code { get; }
    public DateTime Date { get; }


    public EditPendingAttendanceCommand(List<AttendanceRecord> pendingAttendance, string code, DateTime date, EditAttendanceRecordDto dto)
    {
        PendingAttendance = pendingAttendance;
        Code = code;
        Date = date;
        Dto = dto;
    }
}