        --surface: var(--mud-palette-surface);
        --background: var(--mud-palette-background);
        --text-primary: var(--mud-palette-text-primary);
        --text-secondary: var(--mud-palette-text-secondary);
        --divider: var(--mud-palette-divider);
        --success: var(--mud-palette-success);
        --error: var(--mud-palette-error);
        --action-hover: var(--mud-palette-action-default-hover);
    }
</style>

@code {
    private List<VacationRequest>? vacationRequests;
    private Dictionary<string, string> employeeNames = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadVacationRequests();
    }

    private async Task LoadVacationRequests()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var result = await VacationService.GetAllVacationRequestsAsync();
            if (result.Success && result.Data != null)
            {
                vacationRequests = result.Data.ToList();
                await LoadEmployeeNames(); // Load all employee names at once
            }
            else
            {
                Snackbar.Add($"Failed to load vacation requests: {result.Message}", Severity.Error);
                vacationRequests = new List<VacationRequest>();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading requests: {ex.Message}", Severity.Error);
            vacationRequests = new List<VacationRequest>();
        }

        isLoading = false;
        StateHasChanged();
    }

    private async Task LoadEmployeeNames()
    {
        if (vacationRequests == null) return;

        // Get unique user IDs from all vacation requests
        var uniqueUserIds = vacationRequests
            .Where(r => !string.IsNullOrEmpty(r.UserId))
            .Select(r => r.UserId)
            .Distinct()
            .ToList();

        foreach (var userId in uniqueUserIds)
        {
            if (!employeeNames.ContainsKey(userId))
            {
                try
                {
                    // Use async/await properly - NO .Result!
                    var userResult = await ManagementService.GetApplicationUserAsync(userId);
                    employeeNames[userId] = userResult?.Name ?? "Unknown";
                }
                catch (Exception ex)
                {
                    employeeNames[userId] = "Error loading";
                    Console.WriteLine($"Error loading user {userId}: {ex.Message}");
                }
            }
        }

        StateHasChanged(); // Refresh the UI to show the loaded names
    }

    private async Task Approve(string id)
    {
        var result = await VacationService.ApproveVacationRequestAsync(id);
        if (result.Success)
        {
            Snackbar.Add("Request approved successfully", Severity.Success);
            await LoadVacationRequests();
        }
        else
        {
            Snackbar.Add($"Failed to approve request: {result.Message}", Severity.Error);
        }
    }

    private async Task Reject(string id)
    {
        var result = await VacationService.RejectVacationRequestAsync(id);
        if (result.Success)
        {
            Snackbar.Add("Request rejected successfully", Severity.Warning);
            await LoadVacationRequests();
        }
        else
        {
            Snackbar.Add($"Failed to reject request: {result.Message}", Severity.Error);
        }
    }
    private async Task Delete(string id)
    {
        var result = await VacationService.DeleteVacationRequestAsync(id);
        if (result.Success)
        {
            Snackbar.Add("Request deleted successfully", Severity.Info);
            await LoadVacationRequests();
        }
        else
        {
            Snackbar.Add($"Failed to delete request: {result.Message}", Severity.Error);
        }
    }

    private Color GetStatusColor(VacationRequestStatus status) => status switch
    {
        VacationRequestStatus.Approved => Color.Success,
        VacationRequestStatus.Rejected => Color.Error,
        VacationRequestStatus.Pending => Color.Warning,
        VacationRequestStatus.Cancelled => Color.Info,
        _ => Color.Default
    };
}