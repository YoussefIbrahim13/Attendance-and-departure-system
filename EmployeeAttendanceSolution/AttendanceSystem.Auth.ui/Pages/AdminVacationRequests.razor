        transform: translateY(-1px);
        transition: all 0.2s ease;
    }

    .table-cell {
        padding: 1rem 0.5rem;
        border-bottom: 1px solid var(--mud-palette-divider);
        vertical-align: middle;
        color: var(--mud-palette-text-primary);
    }

    .status-chip {
        font-weight: 600;
