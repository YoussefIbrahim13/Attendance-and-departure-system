@page "/admin/vacation-requests"
@attribute [Authorize(Roles = "Admin")]
@inject VacationRequestServices VacationService
@inject ManagementService ManagementService
@inject ISnackbar Snackbar


<MudContainer MaxWidth="MaxWidth.Large" Class="admin-vacation-container">

    <!-- Header Section -->
    <div class="admin-header">
        <MudText Color="Color.Default" Typo="Typo.h4" Class="mb-1">
            All Vacation Requests
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Primary">
            Manage and review all employee vacation requests
        </MudText>
    </div>

    @if (isLoading)
    {
        <div class="loading-container">
            <div class="text-center">
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-3 w-50" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Loading vacation requests...
                </MudText>
            </div>
        </div>
    }
    else if (vacationRequests?.Any() == true)
    {
        <div class="admin-table-container">
            <MudTable Items="@vacationRequests" Hover="true" Dense="true" Striped="true">
                <HeaderContent>
                    <MudTh Class="table-header">Employee Name</MudTh>
                    <MudTh Class="table-header">From Date</MudTh>
                    <MudTh Class="table-header">To Date</MudTh>
                    <MudTh Class="table-header">Reason</MudTh>
                    <MudTh Class="table-header">Status</MudTh>
                    <MudTh Class="table-header">Actions</MudTh>
                    <MudTh Class="table-header">Delete Request</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Class="table-cell">
                        <span class="employee-name">
                            @(employeeNames.ContainsKey(context.UserId) ? employeeNames[context.UserId] : "Loading...")
                        </span>
                    </MudTd>
                    <MudTd Class="table-cell date-cell">
                        @context.FromTime.ToShortDateString()
                    </MudTd>
                    <MudTd Class="table-cell date-cell">
                        @context.ToTime.ToShortDateString()
                    </MudTd>
                    <MudTd Class="table-cell reason-cell" Title="@context.Reason">
                        @context.Reason
                    </MudTd>
                    <MudTd Class="table-cell">
                        <MudChip T="String"
                                 Color="@GetStatusColor(context.Status)"
                                 Size="Size.Small"
                                 Class="status-chip">
                            @context.Status.ToString()
                        </MudChip>
                    </MudTd>
                    <MudTd Class="table-cell">
                        @if (context.Status == VacationRequestStatus.Pending)
                        {
                            <div class="action-buttons">
                                <button class="approve-btn" onclick="@(() => Approve(context.Id.ToString()))">
                                    ✅ Approve
                                </button>
                                <button class="reject-btn" onclick="@(() => Reject(context.Id.ToString()))">
                                    ❌ Reject
                                </button>
                            </div>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="no-action-text">
                                No Action Required
                            </MudText>
                        }
                    </MudTd>
                    <MudTd Class="table-cell">
                        <div class="action-buttons">
                            <button class="delete-btn" onclick="@(() => Delete(context.Id.ToString()))">
                                🗑 Delete
                            </button>
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </div>
    }
    else
    {
        <div class="no-requests-container">
            <div class="no-requests-icon">📋</div>
            <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mb-2">
                No Vacation Requests Found
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                There are no vacation requests to display at this time.
            </MudText>
        </div>
    }
</MudContainer>

<style>
