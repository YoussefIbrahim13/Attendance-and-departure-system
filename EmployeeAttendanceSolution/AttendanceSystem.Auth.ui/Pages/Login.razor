@page "/login"
@using System.ComponentModel.DataAnnotations
@using MudBlazor
@inject AuthService AuthService
@inject NavigationManager Navigation

<MudPaper Class="mx-auto mt-12 pa-6" Style="max-width: 400px;" Elevation="4">
    <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4">🔐 Login</MudText>

    <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <MudTextField @bind-Value="loginModel.Email"
                      Label="Email"
                      Variant="Variant.Outlined"
                      For="@(() => loginModel.Email)"
                      Required="true"
                      FullWidth="true"
                      Class="mb-4" />

        <MudTextField @bind-Value="loginModel.Password"
                      Label="Password"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password"
                      For="@(() => loginModel.Password)"
                      Required="true"
                      FullWidth="true"
                      Class="mb-4" />

        <MudButton ButtonType="ButtonType.Submit"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   FullWidth="true">
            Login
        </MudButton>

        @if (errorMessage != null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@errorMessage</MudAlert>
        }
    </EditForm>
</MudPaper>

@code {
    private LoginModel loginModel = new();
    private string? errorMessage;

    private async Task HandleLogin()
    {
        Console.WriteLine($"[Login] Submitted: {loginModel.Email}, {loginModel.Password}");
        errorMessage = null;

        try
        {
            var loginResult = await AuthService.Login(loginModel);

            if (loginResult.Success)
            {
                var currentUser = await AuthService.GetCurrentUser();
                Navigation.NavigateTo(currentUser?.IsAdmin == true
                    ? "/admin/users"
                    : "/");
            }
            else
            {
                errorMessage = loginResult.Error ?? "Invalid login attempt";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Login failed. Please try again.";
            Console.Error.WriteLine(ex);
        }
    }

    
}

