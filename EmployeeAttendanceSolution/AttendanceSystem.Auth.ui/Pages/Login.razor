@page "/login"
@using System.ComponentModel.DataAnnotations
@using MudBlazor
@inject AuthService AuthService
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.Small" Class="enhanced-login-container">
    <!-- Enhanced Header Section -->
    <MudPaper Class="enhanced-header-section" Elevation="0">
        <div class="header-content">
            <MudIcon Icon="@Icons.Material.Filled.Lock"
                     Class="header-icon"
                     Size="Size.Large" />
            <MudText Typo="Typo.h4" Class="header-title">
                Welcome Back
            </MudText>
            <MudText Typo="Typo.body2" Class="header-subtitle">
                Sign in to your attendance management system
            </MudText>
        </div>
        <div class="header-decoration"></div>
    </MudPaper>

    <!-- Enhanced Login Card -->
    <MudPaper Class="enhanced-form-section" Elevation="0">
        <div class="form-header">
            <div class="section-divider">
                <MudIcon Icon="@Icons.Material.Filled.Login" Class="section-icon" />
                <MudText Typo="Typo.subtitle1" Class="section-title">Authentication</MudText>
            </div>
        </div>

        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <MudGrid Spacing="3" Class="form-grid">
                <MudItem xs="12">
                    <div class="enhanced-input-wrapper">
                        <MudTextField @bind-Value="loginModel.Email"
                                      Label="Email Address"
                                      Variant="Variant.Outlined"
                                      For="@(() => loginModel.Email)"
                                      Required="true"
                                      FullWidth="true"
                                      Class="enhanced-input-field"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Email" />
                        <MudText Typo="Typo.caption" Class="enhanced-hint-text">
                            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="hint-icon" />
                            Enter your registered email address
                        </MudText>
                    </div>
                </MudItem>

                <MudItem xs="12">
                    <div class="enhanced-input-wrapper">
                        <MudTextField @bind-Value="loginModel.Password"
                                      Label="Password"
                                      Variant="Variant.Outlined"
                                      InputType="InputType.Password"
                                      For="@(() => loginModel.Password)"
                                      Required="true"
                                      FullWidth="true"
                                      Class="enhanced-input-field"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />
                        <MudText Typo="Typo.caption" Class="enhanced-hint-text">
                            <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Small" Class="hint-icon" />
                            Enter your secure password
                        </MudText>
                    </div>
                </MudItem>

                @if (errorMessage != null)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Error" Class="enhanced-error-alert">
                            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Small" />
                                <MudText>@errorMessage</MudText>
                            </MudStack>
                        </MudAlert>
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudButton ButtonType="ButtonType.Submit"
                               Color="Color.Primary"
                               Variant="Variant.Filled"
                               FullWidth="true"
                               Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.Login"
                               Class="enhanced-login-button">
                        Sign In to System
                    </MudButton>
                </MudItem>
            </MudGrid>
        </EditForm>

        <!-- Additional Features Section -->
        <MudPaper Class="enhanced-features-section" Elevation="0">
            <div class="section-divider">
                <MudIcon Icon="@Icons.Material.Filled.FeaturedPlayList" Class="section-icon" />
                <MudText Typo="Typo.subtitle1" Class="section-title">System Features</MudText>
            </div>

            <MudGrid Spacing="2" Class="features-grid">
                <MudItem xs="12" sm="6">
                    <div class="feature-item">
                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Class="feature-icon" Color="Color.Primary" />
                        <MudText Typo="Typo.body2" Class="feature-text">Time Tracking</MudText>
                    </div>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <div class="feature-item">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Class="feature-icon" Color="Color.Secondary" />
                        <MudText Typo="Typo.body2" Class="feature-text">Calendar Views</MudText>
                    </div>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <div class="feature-item">
                        <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Class="feature-icon" Color="Color.Info" />
                        <MudText Typo="Typo.body2" Class="feature-text">Role Management</MudText>
                    </div>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <div class="feature-item">
                        <MudIcon Icon="@Icons.Material.Filled.Analytics" Class="feature-icon" Color="Color.Success" />
                        <MudText Typo="Typo.body2" Class="feature-text">Reports & Analytics</MudText>
                    </div>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudPaper>

    <!-- Enhanced Footer Section -->
    <MudPaper Class="enhanced-footer-section" Elevation="0">
        <MudStack AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center" Class="footer-title">
                Attendance Management System
            </MudText>
            <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Class="footer-features">
                <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Small" Color="Color.Primary" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">Secure</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">•</MudText>
                <MudIcon Icon="@Icons.Material.Filled.Speed" Size="Size.Small" Color="Color.Primary" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">Fast</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">•</MudText>
                <MudIcon Icon="@Icons.Material.Filled.Verified" Size="Size.Small" Color="Color.Primary" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">Reliable</MudText>
            </MudStack>
        </MudStack>
    </MudPaper>
</MudContainer>

<style>
    /* Enhanced Container */
    .enhanced-login-container {
        padding: 24px 16px;
        background: linear-gradient(135deg, var(--mud-palette-background) 0%, var(--mud-palette-surface) 100%);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    /* Enhanced Header Section */
    .enhanced-header-section {
        background: linear-gradient(135deg, var(--mud-palette-primary) 0%, var(--mud-palette-secondary) 100%);
        padding: 32px 24px 24px 24px;
        margin-bottom: 24px;
        border-radius: 20px;
        position: relative;
        overflow: hidden;
    }

    .header-content {
        text-align: center;
        position: relative;
        z-index: 2;
    }

    .header-icon {
        color: rgba(255, 255, 255, 0.9) !important;
        margin-bottom: 12px;
        filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
    }

    .header-title {
        color: white !important;
        font-weight: 700 !important;
        margin-bottom: 8px !important;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
    }

    .header-subtitle {
        color: rgba(255, 255, 255, 0.85) !important;
        font-weight: 400 !important;
    }

    .header-decoration {
        position: absolute;
        top: -50%;
        right: -20%;
        width: 200px;
        height: 200px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 50%;
        z-index: 1;
    }

        .header-decoration::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 150px;
            height: 150px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 50%;
            transform: translate(-50%, -50%);
        }

    /* Enhanced Form Section */
    .enhanced-form-section {
        background-color: var(--mud-palette-surface);
        border-radius: 20px;
        padding: 32px 24px;
        margin-bottom: 24px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
        border: 1px solid var(--mud-palette-lines-default);
    }

    .form-header {
        margin-bottom: 24px;
    }

    .form-grid {
        max-width: 100%;
    }

    /* Section Dividers */
    .section-divider {
        display: flex;
        align-items: center;
        margin-bottom: 16px;
        padding-bottom: 8px;
        border-bottom: 2px solid var(--mud-palette-primary);
        position: relative;
    }

        .section-divider::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 40px;
            height: 2px;
            background: var(--mud-palette-secondary);
        }

    .section-icon {
        color: var(--mud-palette-primary) !important;
        margin-right: 12px;
    }

    .section-title {
        color: var(--mud-palette-text-primary) !important;
        font-weight: 600 !important;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Enhanced Input Fields */
    .enhanced-input-wrapper {
        position: relative;
        margin-bottom: 8px;
    }

    .enhanced-input-field {
        border-radius: 12px !important;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .enhanced-input-field .mud-input-outlined-border {
            border-color: var(--mud-palette-lines-default);
            border-width: 1.5px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .enhanced-input-field:hover .mud-input-outlined-border {
            border-color: var(--mud-palette-primary);
            box-shadow: 0 0 0 3px rgba(25, 118, 210, 0.1);
        }

        .enhanced-input-field .mud-input:focus-within .mud-input-outlined-border {
            border-color: var(--mud-palette-primary);
            border-width: 2px;
            box-shadow: 0 0 0 4px rgba(25, 118, 210, 0.15);
        }

        .enhanced-input-field .mud-input-adornment-start {
            color: var(--mud-palette-primary) !important;
        }

        .enhanced-input-field .mud-input-label {
            color: var(--mud-palette-text-secondary) !important;
            font-weight: 500 !important;
        }

        .enhanced-input-field .mud-input:focus-within .mud-input-label {
            color: var(--mud-palette-primary) !important;
        }

    /* Enhanced Hint Text */
    .enhanced-hint-text {
        display: flex;
        align-items: center;
        margin-top: 4px;
        color: var(--mud-palette-text-secondary) !important;
        font-size: 0.75rem !important;
    }

    .hint-icon {
        margin-right: 4px !important;
        color: var(--mud-palette-info) !important;
    }

    /* Enhanced Error Alert */
    .enhanced-error-alert {
        border-radius: 12px;
        border-left: 4px solid var(--mud-palette-error);
        background: rgba(244, 67, 54, 0.05);
    }

    /* Enhanced Login Button */
    .enhanced-login-button {
        border-radius: 12px !important;
        font-weight: 600 !important;
        text-transform: none !important;
        letter-spacing: 0.5px !important;
        padding: 16px 24px !important;
        font-size: 1rem !important;
        box-shadow: 0 4px 12px rgba(25, 118, 210, 0.3) !important;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
    }

        .enhanced-login-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(25, 118, 210, 0.4) !important;
        }

    /* Enhanced Features Section */
    .enhanced-features-section {
        background: linear-gradient(135deg, rgba(25, 118, 210, 0.05) 0%, rgba(156, 39, 176, 0.05) 100%);
        border-radius: 16px;
        padding: 24px;
        margin-top: 24px;
        border: 1px solid var(--mud-palette-lines-default);
    }

    .features-grid {
        margin: 0;
    }

    .feature-item {
        display: flex;
        align-items: center;
        padding: 8px 0;
        transition: all 0.2s ease;
    }

        .feature-item:hover {
            transform: translateX(4px);
        }

    .feature-icon {
        margin-right: 12px !important;
        font-size: 1.2rem !important;
    }

    .feature-text {
        color: var(--mud-palette-text-primary) !important;
        font-weight: 500 !important;
    }

    /* Enhanced Footer Section */
    .enhanced-footer-section {
        background-color: transparent;
        padding: 16px;
        text-align: center;
    }

    .footer-title {
        font-weight: 600 !important;
        margin-bottom: 8px !important;
    }

    .footer-features {
        justify-content: center;
    }

   

    }

   

    .enhanced-form-section {
        animation: fadeInUp 0.6s ease-out;
    }

    .enhanced-header-section {
        animation: fadeInUp 0.4s ease-out;
    }

    .enhanced-footer-section {
        animation: fadeInUp 0.8s ease-out;
    }
</style>

@code {
    private LoginModel loginModel = new();
    private string? errorMessage;

    private async Task HandleLogin()
    {
        Console.WriteLine($"[Login] Submitted: {loginModel.Email}, {loginModel.Password}");
        errorMessage = null;

        try
        {
            var loginResult = await AuthService.Login(loginModel);

            if (loginResult.Success)
            {
                var currentUser = await AuthService.GetCurrentUser();
                Navigation.NavigateTo(currentUser?.IsAdmin == true
                    ? "/admin/users"
                    : "/");
            }
            else
            {
                errorMessage = loginResult.Error ?? "Invalid login attempt";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Login failed. Please try again.";
            Console.Error.WriteLine(ex);
        }
    }
}

