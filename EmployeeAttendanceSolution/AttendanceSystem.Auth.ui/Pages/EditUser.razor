@page "/admin/edit-user/{userId}"
@attribute [Authorize(Roles = "Admin")]
@using System.Net.Http.Headers

@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" GutterBottom="true">Edit User</MudText>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
    }

    @if (isLoading)
    {
        <MudContainer Class="d-flex justify-center my-4">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </MudContainer>
    }
    else if (user == null)
    {
        <MudAlert Severity="Severity.Warning">Loading user data...</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4" Elevation="2">
            <EditForm Model="user" OnValidSubmit="HandleSave">
                <DataAnnotationsValidator />
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudTextField Label="Name" @bind-Value="user.Name" 
                                    Required="true" 
                                    RequiredError="Name is required"
                                    Variant="Variant.Outlined" />
                        <ValidationMessage For="@(() => user.Name)" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField Label="Email" @bind-Value="user.Email" 
                                    Required="true" 
                                    RequiredError="Email is required"
                                    Variant="Variant.Outlined" />
                        <ValidationMessage For="@(() => user.Email)" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField Label="Department" @bind-Value="user.Department" 
                                    Variant="Variant.Outlined" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField Label="Position" @bind-Value="user.Position" 
                                    Variant="Variant.Outlined" />
                    </MudItem>

                    <MudItem xs="12" Class="d-flex align-center gap-2">
                        <MudTooltip Text="@(user.IsApproved ? "Click to revoke approval" : "Click to approve this user")">
                            <MudToggleIconButton @bind-Toggled="user.IsApproved"
                                                 Icon="@Icons.Material.Filled.Close"
                                                 Color="@Color.Error"
                                                 ToggledIcon="@Icons.Material.Filled.Check"
                                                 ToggledColor="@Color.Success"
                                                 Disabled="@isLoading" />
                        </MudTooltip>

                        <MudText Typo="Typo.body2">
                            Status:
                            <MudBadge Color="@(user.IsApproved? Color.Success: Color.Error)"
                                      Class="ml-1"
                                      Variant="Variant.Filled">
                                @(user.IsApproved ? "Approved" : "Pending Approval")
                            </MudBadge>
                        </MudText>
                    </MudItem>

                    <MudItem xs="12" Class="d-flex justify-end gap-2">
                        <MudButton Variant="Variant.Outlined" 
                                 Color="Color.Default" 
                                 OnClick="Cancel" 
                                 Disabled="@isLoading">
                            Cancel
                        </MudButton>
                        <MudButton ButtonType="ButtonType.Submit" 
                                 Variant="Variant.Filled" 
                                 Color="Color.Primary" 
                                 Disabled="@isLoading">
                            @if (isLoading)
                            {
                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                <MudText Class="ms-2">Saving...</MudText>
                            }
                            else
                            {
                                <MudText>Save Changes</MudText>
                            }
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </EditForm>
        </MudPaper>
    }
</MudContainer>

@code {
    [Parameter]
    public string UserId { get; set; }

    private UserUpdateDto user = new();
    private string errorMessage = string.Empty;
    private bool isLoading;

    protected override async Task OnInitializedAsync()
    {
        await LoadUser();
    }

    private async Task LoadUser()
    {
        isLoading = true;
        errorMessage = string.Empty;
        StateHasChanged();

        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            var request = new HttpRequestMessage(HttpMethod.Get, $"api/Management/GetApplicationUser/{UserId}");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<UserResponseDto>();
                user = new UserUpdateDto
                {
                    Name = result.Name,
                    Email = result.Email,
                    Department = result.Department,
                    Position = result.Position,
                    IsApproved = result.IsApproved
                };
                // Store original values
                originalName = user.Name;
                originalEmail = user.Email;
                originalDepartment = user.Department;
                originalPosition = user.Position;
                originalIsApproved = user.IsApproved;
            }
            else
            {
                await HandleApiError(response);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load user: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleSave()
    {
        isLoading = true;
        errorMessage = string.Empty;
        StateHasChanged();

        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            var request = new HttpRequestMessage(HttpMethod.Put, $"api/Management/UpdateApplicationUser/{UserId}");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            request.Content = JsonContent.Create(user);

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                await JSRuntime.InvokeVoidAsync("alert", "User updated successfully");
                Navigation.NavigateTo("/admin/users");
            }
            else
            {
                await HandleApiError(response);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save user: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleApiError(HttpResponseMessage response)
    {
        if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            errorMessage = "Session expired. Redirecting to login...";
            StateHasChanged();
            await Task.Delay(1500);
            await ((JwtAuthenticationStateProvider)AuthStateProvider).NotifyUserLogout();
            Navigation.NavigateTo("/login", true);
            return;
        }

        try
        {
            var errorResult = await response.Content.ReadFromJsonAsync<OperationResult>();
            errorMessage = errorResult?.Message ?? $"Error: {response.StatusCode}";
        }
        catch
        {
            errorMessage = await response.Content.ReadAsStringAsync();
        }
    }

    private async Task Cancel()
    {
        if (user != null &&
            (user.Name != originalName ||
             user.Email != originalEmail ||
             user.Department != originalDepartment ||
             user.Position != originalPosition ||
             user.IsApproved != originalIsApproved))
        {
            if (!await JSRuntime.InvokeAsync<bool>("confirm", "You have unsaved changes. Are you sure you want to leave?"))
            {
                return;
            }
        }
        Navigation.NavigateTo("/admin/users");
    }

    // Track original values for dirty checking
    private string originalName;
    private string originalEmail;
    private string originalDepartment;
    private string originalPosition;
    private bool originalIsApproved;

   
}

