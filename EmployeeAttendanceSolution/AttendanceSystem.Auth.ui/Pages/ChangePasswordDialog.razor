</style>

@code {
    [CascadingParameter]
    public IMudDialogInstance MudDialog { get; set; } = null!;

    private ChangePasswordModel model = new();
    private string currentUserId = string.Empty;

    private bool IsPasswordMatch() => model.NewPassword == model.ConfirmPassword;
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            currentUserId = await CurrentUser.GetUserIdAsync();

            if (string.IsNullOrEmpty(currentUserId))
            {
                Snackbar.Add("User not authenticated", Severity.Error);
                MudDialog.Cancel();
                return;
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error getting user ID: {ex.Message}");
            Snackbar.Add("Error verifying user identity", Severity.Error);
            MudDialog.Cancel();
        }
    
    }
    private bool IsFormValid()
    {
        return !string.IsNullOrWhiteSpace(model.CurrentPassword) &&
               IsPasswordValid(model.NewPassword) &&
               IsPasswordMatch();
    }


    private IEnumerable<string> ValidatePassword(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            yield return "Password is required";
        else if (value.Length < 8)
            yield return "Must be at least 8 characters";
        else if (!value.Any(char.IsUpper))
            yield return "Requires 1 uppercase letter";
        else if (!value.Any(char.IsLower))
            yield return "Requires 1 lowercase letter";
        else if (!value.Any(char.IsDigit))
            yield return "Requires 1 number";
    }

    private bool IsPasswordValid(string password)
    {
        return !string.IsNullOrWhiteSpace(password) &&
               password.Length >= 8 &&
               password.Any(char.IsUpper) &&
               password.Any(char.IsLower) &&
               password.Any(char.IsDigit);
    }

    private async Task ChangePassword()
    {
        try
        {
            isLoading = true;

            if (!IsPasswordMatch())
            {
                Snackbar.Add("Passwords do not match", Severity.Error);
                return;
            }

            if (!IsPasswordValid(model.NewPassword))
            {
                Snackbar.Add("Password does not meet requirements", Severity.Error);
                return;
            }
  
            var result = await ManagementServices.ChangePasswordAsync(currentUserId, model.NewPassword);

            if (!result.Success)
            {
                Snackbar.Add(result.Message ?? "Failed to change password", Severity.Error);
                return;
            }

            Snackbar.Add("Password changed successfully", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Password change failed: {ex.Message}");
            Snackbar.Add("An unexpected error occurred while changing password", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }


    private void Cancel() => MudDialog.Cancel();

   
}