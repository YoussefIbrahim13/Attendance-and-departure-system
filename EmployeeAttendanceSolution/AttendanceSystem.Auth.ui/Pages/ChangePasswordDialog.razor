        max-width: 100%;
    }

    /* Section Dividers */
    .section-divider {
        display: flex;
        align-items: center;
        margin: 24px 0 16px 0;
        padding-bottom: 8px;
        border-bottom: 2px solid var(--mud-palette-primary);
