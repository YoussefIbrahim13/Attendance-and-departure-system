@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ManagementService ManagementServices
@inject AuthenticationStateProvider AuthStateProvider
@inject CurrentUserService CurrentUser


<MudDialog Class="enhanced-dialog-container" MaxWidth="MaxWidth.Small" FullHeight="true">
    <DialogContent>
        <MudContainer Class="enhanced-form-container" Style="padding: 0;">
            <!-- Enhanced Header Section -->
            <MudPaper Class="enhanced-header-section" Elevation="0">
                <div class="header-content">
                    <MudIcon Icon="@Icons.Material.Filled.Lock"
                             Class="header-icon"
                             Size="Size.Large" />
                    <MudText Typo="Typo.h4" Class="header-title">
                        Change Password
                    </MudText>
                    <MudText Typo="Typo.body2" Class="header-subtitle">
                        Update your account password for enhanced security
                    </MudText>
                </div>
                <div class="header-decoration"></div>
            </MudPaper>

            <!-- Enhanced Form Section -->
            <MudPaper Class="enhanced-form-section" Elevation="0">
                <EditForm Model="@model" OnValidSubmit="ChangePassword">
                    <DataAnnotationsValidator />
                    <MudGrid Spacing="3" Class="form-grid">
                        <!-- Current Password Section -->
                        <MudItem xs="12">
                            <div class="section-divider">
                                <MudIcon Icon="@Icons.Material.Filled.Security" Class="section-icon" />
                                <MudText Typo="Typo.subtitle1" Class="section-title">Current Authentication</MudText>
                            </div>
                        </MudItem>

                        <MudItem xs="12">
                            <div class="enhanced-input-wrapper">
                                <MudTextField T="string"
                                              @bind-Value="model.CurrentPassword"
                                              Label="Current Password"
                                              InputType="InputType.Password"
                                              Required="true"
                                              RequiredError="Current password is required"
                                              Variant="Variant.Outlined"
                                              Class="enhanced-input-field"
                                              Margin="Margin.Dense"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Key" />
                                <MudText Typo="Typo.caption" Class="enhanced-hint-text">
                                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="hint-icon" />
                                    Enter your current password to verify your identity
                                </MudText>
                            </div>
                        </MudItem>

                        <!-- New Password Section -->
                        <MudItem xs="12">
                            <div class="section-divider">
                                <MudIcon Icon="@Icons.Material.Filled.LockReset" Class="section-icon" />
                                <MudText Typo="Typo.subtitle1" Class="section-title">New Password</MudText>
                            </div>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <div class="enhanced-input-wrapper">
                                <MudTextField T="string"
                                              Label="New Password"
                                              @bind-Value="model.NewPassword"
                                              InputType="InputType.Password"
                                              Required="true"
                                              RequiredError="New password is required"
                                              Validation="@(new Func<string, IEnumerable<string>>(ValidatePassword))"
                                              Variant="Variant.Outlined"
                                              Class="enhanced-input-field"
                                              Margin="Margin.Dense"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Lock" />
                                <MudText Typo="Typo.caption" Class="enhanced-hint-text">
                                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="hint-icon" />
                                    Minimum 8 characters with uppercase, lowercase, and number
                                </MudText>
                            </div>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <div class="enhanced-input-wrapper">
                                <MudTextField T="string"
                                              Label="Confirm New Password"
                                              @bind-Value="model.ConfirmPassword"
                                              InputType="InputType.Password"
                                              Required="true"
                                              RequiredError="Confirm password is required"
                                              Variant="Variant.Outlined"
                                              Class="enhanced-input-field"
                                              Margin="Margin.Dense"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.LockOpen" />
                                
                                @if (!string.IsNullOrEmpty(model.ConfirmPassword) && !IsPasswordMatch())
                                {
                                    <MudText Typo="Typo.caption" Class="password-mismatch-text">
                                        <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Class="warning-icon" />
                                        Passwords do not match
                                    </MudText>
                                }
                                else if (!string.IsNullOrEmpty(model.ConfirmPassword) && IsPasswordMatch())
                                {
                                    <MudText Typo="Typo.caption" Class="password-match-text">
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="success-icon" />
                                        Passwords match
                                    </MudText>
                                }
                            </div>
                        </MudItem>

                        <!-- Security Tips Section -->
                        <MudItem xs="12">
                            <div class="security-tips-section">
                                <MudText Typo="Typo.subtitle2" Class="tips-title">
                                    <MudIcon Icon="@Icons.Material.Filled.Shield" Class="tips-icon" />
                                    Security Tips
                                </MudText>
                                <div class="tips-list">
                                    <div class="tip-item">
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="tip-check" Size="Size.Small" />
                                        <MudText Typo="Typo.body2">Use a unique password you haven't used before</MudText>
                                    </div>
                                    <div class="tip-item">
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="tip-check" Size="Size.Small" />
                                        <MudText Typo="Typo.body2">Include a mix of letters, numbers, and symbols</MudText>
                                    </div>
                                    <div class="tip-item">
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="tip-check" Size="Size.Small" />
                                        <MudText Typo="Typo.body2">Avoid using personal information</MudText>
                                    </div>
                                </div>
                            </div>
                        </MudItem>
                    </MudGrid>
                </EditForm>
            </MudPaper>
        </MudContainer>
    </DialogContent>

    <DialogActions>
        <MudPaper Elevation="0" Class="enhanced-dialog-actions">
            <div class="actions-content">
                <MudButton OnClick="Cancel"
                           Variant="Variant.Text"
                           Color="Color.Default"
                           Class="enhanced-cancel-button"
                           StartIcon="@Icons.Material.Filled.Close">
                    Cancel
                </MudButton>
                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           OnClick="ChangePassword"
                           Disabled="@(!IsFormValid() || isLoading)"
                           Loading="@isLoading"
                           Class="enhanced-save-button"
                           StartIcon="@Icons.Material.Filled.Save">
                    @if (isLoading)
                    {
                        <span>Updating Password...</span>
                    }
                    else
                    {
                        <span>Change Password</span>
                    }
                </MudButton>
            </div>
        </MudPaper>
    </DialogActions>
</MudDialog>

<style>
