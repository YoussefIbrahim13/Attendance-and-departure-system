    protected override async Task OnInitializedAsync()
    {
        await LoadEmployees();
    }

    private async Task LoadEmployees()
    {
        isLoadingEmployees = true;
        try
        {
            allEmployees = await ManagementService.GetAllEmployeesAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load employees: {ex.Message}", Severity.Error);
            allEmployees = new List<EmployeeResult>();
        }
        finally
        {
            isLoadingEmployees = false;
            StateHasChanged();
        }
    }

    private Task<IEnumerable<EmployeeResult>> SearchEmployees(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(allEmployees.AsEnumerable());

        return Task.FromResult(allEmployees.Where(e =>
            e.Name.Contains(value, StringComparison.OrdinalIgnoreCase) ||
            e.Code.Contains(value, StringComparison.OrdinalIgnoreCase) ||
            e.Department.ToString().Contains(value, StringComparison.OrdinalIgnoreCase) ||
            (e.Position != null && e.Position.ToString().Contains(value, StringComparison.OrdinalIgnoreCase))));
    }

 

    private string GetRoleIcon(string role) => role switch
    {
        "Admin" => Icons.Material.Filled.SupervisorAccount,
        "Manager" => Icons.Material.Filled.ManageAccounts,
