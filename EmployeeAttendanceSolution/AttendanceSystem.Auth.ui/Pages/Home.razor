@page "/"

<PageTitle>Home</PageTitle>

<MudPaper Class="pa-6 mx-auto mt-6" Elevation="4" MaxWidth="600px">
    <MudText Typo="Typo.h4" GutterBottom="true">👋 Hello, world!</MudText>
