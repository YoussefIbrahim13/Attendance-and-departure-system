@page "/admin/users"

@attribute [Authorize(Roles = "Admin")]

@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" GutterBottom="true">User Management</MudText>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
    }

    @if (isLoading)
    {
        <MudContainer Class="d-flex justify-center my-4">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </MudContainer>
    }
    else if (users == null || !users.Any())
    {
        <MudAlert Severity="Severity.Info">No users found</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4" Elevation="2">
            <MudGrid AlignItems="Center" Class="mb-4">
                <MudItem xs="12" sm="6">
                    <MudButton Variant="Variant.Filled" 
                             Color="Color.Primary" 
                             StartIcon="@Icons.Material.Filled.Add" 
                             OnClick="ShowAddUserModal" 
                             Disabled="@isLoading">
                        Add New User
                    </MudButton>
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex justify-end">
                    <MudTextField @bind-Value="searchTerm" 
                                Label="Search users..." 
                                Variant="Variant.Outlined" 
                                Adornment="Adornment.End" 
                                AdornmentIcon="@Icons.Material.Filled.Search" 
                                OnAdornmentClick="SearchUsers"
                                OnKeyUp="@(async (e) => { if (e.Key == "Enter") await SearchUsers(); })"
                                Style="max-width: 300px;" />
                </MudItem>
            </MudGrid>

            <MudTable Items="@filteredUsers" Hover="true" Striped="true" Dense="true">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Email</MudTh>
                    <MudTh>Department</MudTh>
                    <MudTh>Position</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Roles</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">@context.Name</MudTd>
                    <MudTd DataLabel="Email">@context.Email</MudTd>
                    <MudTd DataLabel="Department">@context.Department</MudTd>
                    <MudTd DataLabel="Position">@context.Position</MudTd>
                    <MudTd DataLabel="Status">
                        @if (context.IsApproved)
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">Approved</MudChip>
                        }
                        else
                        {
                            <MudChipT="string" Color="Color.Warning" Size="Size.Small">Pending</MudChipT>
                        }
                    </MudTd>
                    <MudTd DataLabel="Roles">@string.Join(", ", context.Roles)</MudTd>
                    <MudTd DataLabel="Actions">
                        <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                         Color="Color.Info" 
                                         OnClick="() => EditUser(context.Id)" 
                                         Title="Edit" 
                                         Disabled="@isLoading" />
                            @if (!context.IsApproved)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" 
                                             Color="Color.Success" 
                                             OnClick="() => ApproveUser(context.Id)" 
                                             Title="Approve" 
                                             Disabled="@isLoading" />
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                         Color="Color.Error" 
                                         OnClick="() => DeleteUser(context.Id)" 
                                         Title="Delete" 
                                         Disabled="@isLoading" />
                        </MudButtonGroup>
                    </MudTd>
                </RowTemplate>
            </MudTable>

            <MudGrid AlignItems="Center" Class="mt-4">
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2">Showing @filteredUsers.Count of @users.Count users</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex justify-end">
                    <MudPagination Count="@((int)Math.Ceiling((double)users.Count / pageSize))"
                                   @bind-Selected="currentPage" />
                </MudItem>
            </MudGrid>
        </MudPaper>
    }
</MudContainer>

<!-- Add User Modal -->
<MudDialog @bind-IsVisible="showAddModal" Options="@(new DialogOptions() { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Class="mr-3" />
            Add New User
        </MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="@newUser" OnValidSubmit="HandleAddUser">
            <DataAnnotationsValidator />
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Name" @bind-Value="newUser.Name" 
                                Required="true" 
                                RequiredError="Name is required"
                                Variant="Variant.Outlined" />
                    <ValidationMessage For="@(() => newUser.Name)" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField Label="Email" @bind-Value="newUser.Email" 
                                Required="true" 
                                RequiredError="Email is required"
                                Variant="Variant.Outlined" />
                    <ValidationMessage For="@(() => newUser.Email)" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField Label="Password" @bind-Value="newUser.Password" 
                                InputType="InputType.Password"
                                Required="true" 
                                RequiredError="Password is required"
                                Variant="Variant.Outlined" />
                    <ValidationMessage For="@(() => newUser.Password)" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Minimum 8 characters with at least 1 uppercase, 1 lowercase, 1 number
                    </MudText>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField Label="Confirm Password" @bind-Value="confirmPassword" 
                                InputType="InputType.Password"
                                Required="true" 
                                RequiredError="Confirm password is required"
                                Variant="Variant.Outlined" />
                    <ValidationMessage For="@(() => confirmPassword)" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField Label="Department" @bind-Value="newUser.Department" 
                                Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField Label="Position" @bind-Value="newUser.Position" 
                                Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12">
                    <MudSelect T="string" @bind-Value="selectedRole" 
                             Label="Role" 
                             Required="true" 
                             RequiredError="Role is required"
                             Variant="Variant.Outlined">
                        @foreach (var role in availableRoles)
                        {
                            <MudSelectItem Value="@role">@role</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseAddUserModal" 
                 Variant="Variant.Text" 
                 Disabled="@isLoading">
            Cancel
        </MudButton>
        <MudButton OnClick="HandleAddUser" 
                 Variant="Variant.Filled" 
                 Color="Color.Primary" 
                 Disabled="@isLoading">
            @if (isLoading)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Saving...</MudText>
            }
            else
            {
                <MudText>Save User</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<UserResponseDto> users = new();
    private List<UserResponseDto> filteredUsers = new();
    private List<string> availableRoles = new() { "User", "Manager", "Admin" };
    private bool showAddModal = false;
    private UserCreateDto newUser = new();
    private string confirmPassword = string.Empty;
    private string selectedRole = "User";
    private string errorMessage = string.Empty;
    private string searchTerm = string.Empty;
    private bool isLoading;
    // private int currentPage = 1;
    private int pageSize = 10;
    private int currentPageBacking = 1;
    private int currentPage
    {
        get => currentPageBacking;
        set
        {
            currentPageBacking = value;
            FilterUsers();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        isLoading = true;
        errorMessage = string.Empty;
        StateHasChanged();

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var token = await LocalStorage.GetItemAsync<string>("authToken");

            var request = new HttpRequestMessage(HttpMethod.Get, "api/Management/GetAllUsers");
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<OperationResult<List<UserResponseDto>>>();
                
                if (result?.Success == true)
                {
                    users = result.Data ?? new List<UserResponseDto>();
                    FilterUsers();
                }
                else
                {
                    errorMessage = result?.Message ?? "Failed to load users";
                }
            }
            else
            {
                await HandleApiError(response);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
            Console.Error.WriteLine(ex);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void FilterUsers()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredUsers = users
                .Skip((currentPage - 1) * pageSize)
                .Take(pageSize)
                .ToList();
        }
        else
        {
            var term = searchTerm.ToLower();
            filteredUsers = users
                .Where(u =>
                    u.Name?.ToLower().Contains(term) == true ||
                    u.Email?.ToLower().Contains(term) == true ||
                    u.Department?.ToLower().Contains(term) == true ||
                    u.Position?.ToLower().Contains(term) == true ||
                    u.Roles.Any(r => r.ToLower().Contains(term))
                )
                .Skip((currentPage - 1) * pageSize)
                .Take(pageSize)
                .ToList();
        }
    }

    private async Task SearchUsers()
    {
        currentPage = 1;
        FilterUsers();
        StateHasChanged();
    }

    private void ChangePage(int direction)
    {
        currentPage += direction;
        FilterUsers();
    }

    private async Task HandleApiError(HttpResponseMessage response)
    {
        if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            errorMessage = "Session expired. Redirecting to login...";
            StateHasChanged();
            await Task.Delay(1500);
            await ((JwtAuthenticationStateProvider)AuthStateProvider).NotifyUserLogout();
            Navigation.NavigateTo("/login", true);
            return;
        }

        try
        {
            var errorResult = await response.Content.ReadFromJsonAsync<OperationResult>();
            errorMessage = errorResult?.Message ?? $"Error: {response.StatusCode}";
        }
        catch
        {
            errorMessage = await response.Content.ReadAsStringAsync();
        }
    }

    private void ShowAddUserModal()
    {
        newUser = new UserCreateDto();
        confirmPassword = string.Empty;
        selectedRole = "User";
        showAddModal = true;
    }

    private void CloseAddUserModal()
    {
        showAddModal = false;
    }

    private async Task HandleAddUser()
    {
        if (newUser.Password != confirmPassword)
        {
            errorMessage = "Passwords do not match";
            return;
        }

        isLoading = true;
        errorMessage = string.Empty;
        StateHasChanged();

        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            var request = new HttpRequestMessage(HttpMethod.Post, $"api/Management/AddApplicationUser?roleName={selectedRole}");
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            request.Content = JsonContent.Create(newUser);

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                await LoadUsers();
                showAddModal = false;
            }
            else
            {
                await HandleApiError(response);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to add user: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ApproveUser(string userId)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to approve this user?"))
            return;

        isLoading = true;
        errorMessage = string.Empty;
        StateHasChanged();

        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            var request = new HttpRequestMessage(HttpMethod.Post, $"api/Management/approve/{userId}");
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                await LoadUsers();
            }
            else
            {
                await HandleApiError(response);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to approve user: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void EditUser(string userId)
    {
        Navigation.NavigateTo($"/admin/edit-user/{userId}");
    }

    private async Task DeleteUser(string userId)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this user? This action cannot be undone."))
            return;

        isLoading = true;
        errorMessage = string.Empty;
        StateHasChanged();

        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            var request = new HttpRequestMessage(HttpMethod.Delete, $"api/Management/DeleteApplicationUser/{userId}");
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                await LoadUsers();
            }
            else
            {
                await HandleApiError(response);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete user: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}

