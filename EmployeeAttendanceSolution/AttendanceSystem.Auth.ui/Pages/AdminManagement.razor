@page "/admin/users"

@attribute [Authorize(Roles = "Admin")]

@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider
@inject IDialogService DialogService
@inject ManagementService ManagementService
@inject ISnackbar Snackbar
@inject CurrentUserService CurrentUser

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="enhanced-admin-container">
    <!-- Enhanced Header Section -->
    <MudPaper Class="enhanced-header-section" Elevation="0">
        <div class="header-content">
            <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings"
                     Class="header-icon"
                     Size="Size.Large" />
            <MudText Typo="Typo.h4" Class="header-title">
                User Management
            </MudText>
            <MudText Typo="Typo.body2" Class="header-subtitle">
                Manage users, roles, and permissions in your attendance system
            </MudText>
        </div>
        <div class="header-decoration"></div>
    </MudPaper>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="enhanced-alert">
            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Small" />
                <MudText>@errorMessage</MudText>
            </MudStack>
        </MudAlert>
    }

    @if (isLoading)
    {
        <MudContainer Class="enhanced-loading-container">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body1" Class="loading-text">Loading users...</MudText>
        </MudContainer>
    }
    else if (users == null || !users.Any())
    {
        <MudPaper Class="enhanced-empty-state" Elevation="0">
            <MudIcon Icon="@Icons.Material.Filled.PersonOff" Size="Size.Large" Class="empty-icon" />
            <MudText Typo="Typo.h6" Class="empty-title">No Users Found</MudText>
            <MudText Typo="Typo.body2" Class="empty-subtitle">Start by adding your first user to the system</MudText>
            <MudButton ButtonType="ButtonType.Button"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="@OpenAddUserDialog"
                       StartIcon="@Icons.Material.Filled.PersonAdd"
                       Class="enhanced-add-button">
                Add First User
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="enhanced-content-section" Elevation="0">
            <!-- Enhanced Controls Section -->
            <MudPaper Class="enhanced-controls-section" Elevation="0">
                <MudGrid AlignItems="Center" Class="controls-grid">
                    <MudItem xs="12" sm="6" Class="search-section">
                        <div class="section-divider">
                            <MudIcon Icon="@Icons.Material.Filled.Search" Class="section-icon" />
                            <MudText Typo="Typo.subtitle1" Class="section-title">Search</MudText>
                        </div>
                        <div class="enhanced-input-wrapper">
                            <MudTextField @bind-Value="searchTerm"
                                          Immediate="true"
                                          Variant="Variant.Outlined"
                                          Placeholder="Search users..."
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          Style="width: 100%; max-width: 320px;"
                                          TextChanged="@(e => { searchTerm = e.ToString(); SearchUsers(); })" />
                        </div>
                    </MudItem>
                    <MudItem xs="12" sm="6" Class="actions-section">
                        <div class="section-divider">
                            <MudIcon Icon="@Icons.Material.Filled.Settings" Class="section-icon" />
                            <MudText Typo="Typo.subtitle1" Class="section-title">Actions</MudText>
                        </div>
                        <div class="actions-wrapper">
                            <MudButton ButtonType="ButtonType.Button"
                                       Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       OnClick="@OpenAddUserDialog"
                                       Disabled="@isLoading"
                                       StartIcon="@Icons.Material.Filled.PersonAdd"
                                       Class="enhanced-add-button">
                                Add New User
                            </MudButton>
                        </div>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <!-- Enhanced Table Section -->
            <MudPaper Class="enhanced-table-section" Elevation="0">
                <div class="section-divider">
                    <MudIcon Icon="@Icons.Material.Filled.People" Class="section-icon" />
                    <MudText Typo="Typo.subtitle1" Class="section-title">User Directory</MudText>
                </div>

                <MudTable Items="@filteredUsers"
                          Hover="true"
                          Striped="true"
                          Dense="true"
                          Class="enhanced-table">
                    <HeaderContent>
                        <MudTh Class="enhanced-table-header">Name</MudTh>
                        <MudTh Class="enhanced-table-header">Email</MudTh>
                        <MudTh Class="enhanced-table-header">Department</MudTh>
                        <MudTh Class="enhanced-table-header">Position</MudTh>
                        <MudTh Class="enhanced-table-header">Status</MudTh>
                        <MudTh Class="enhanced-table-header">Roles</MudTh>
                        <MudTh Class="enhanced-table-header">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Name" Class="enhanced-table-cell">
                            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                <MudAvatar Color="Color.Primary" Size="Size.Small">
                                    @context.Name?.Substring(0, 1).ToUpper()
                                </MudAvatar>
                                <MudText Typo="Typo.body2" Class="user-name">@context.Name</MudText>
                            </MudStack>
                        </MudTd>
                        <MudTd DataLabel="Email" Class="enhanced-table-cell">@context.Email</MudTd>
                        <MudTd DataLabel="Department" Class="enhanced-table-cell">@context.Department</MudTd>
                        <MudTd DataLabel="Position" Class="enhanced-table-cell">@context.Position</MudTd>
                        <MudTd DataLabel="Status" Class="enhanced-table-cell">
                            @if (context.IsApproved)
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Class="enhanced-status-chip">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="chip-icon" />
                                    Approved
                                </MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Class="enhanced-status-chip">
                                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="chip-icon" />
                                    Pending
                                </MudChip>
                            }
                        </MudTd>
                        <MudTd DataLabel="Roles" Class="enhanced-table-cell">
                            <MudStack Row Spacing="1">
                                @foreach (var role in context.Roles)
                                {
                                    <MudChip T="string" Size="Size.Small" Class="enhanced-role-chip" Color="@GetRoleColor(role)">
                                        @role
                                    </MudChip>
                                }
                            </MudStack>
                        </MudTd>
                        <MudTd DataLabel="Actions" Class="enhanced-table-cell">
                            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small" Class="enhanced-action-group">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Color="Color.Info"
                                               OnClick="() => EditUser(context.Id)"
                                               Title="Edit"
                                               Disabled="@isLoading"
                                               Class="enhanced-action-button" />
                                @if (!context.IsApproved)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                                   Color="Color.Success"
                                                   OnClick="() => ApproveUser(context.Id)"
                                                   Title="Approve"
                                                   Disabled="@isLoading"
                                                   Class="enhanced-action-button" />
                                }
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               OnClick="() => DeleteUser(context.Id)"
                                               Title="Delete"
                                               Disabled="@isLoading"
                                               Class="enhanced-action-button" />
                            </MudButtonGroup>
                        </MudTd>
                    </RowTemplate>
                </MudTable>

                <!-- Enhanced Pagination Section -->
                <MudPaper Class="enhanced-pagination-section" Elevation="0">
                    <MudGrid AlignItems="Center" Class="pagination-grid">
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.body2" Class="pagination-info">
                                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="info-icon" />
                                Showing @filteredUsers.Count of @TotalDisplayedUsers users
                            </MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6" Class="pagination-controls">
                            <MudPagination Count="@((int)Math.Ceiling((double)TotalDisplayedUsers / pageSize))"
                                           @bind-Selected="currentPage"
                                           Class="enhanced-pagination" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudPaper>
        </MudPaper>
    }
</MudContainer>
