@code {
    private List<UserResponseDto> users = new();
    private List<UserResponseDto> filteredUsers = new();
    private string errorMessage = string.Empty;
    private string searchTerm = string.Empty;
    private bool isLoading;
    private int pageSize = 10;
    private int currentPageBacking = 1;
    private int currentPage
    {
        get => currentPageBacking;
        set
        {
            currentPageBacking = value;
            FilterUsers();
        }
    }
    private string currentUserId = string.Empty;
    private int TotalDisplayedUsers => users.Count - (string.IsNullOrEmpty(currentUserId) ? 0 : 1);


    protected override async Task OnInitializedAsync()
    {
        // var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        // currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        currentUserId = await CurrentUser.GetUserIdAsync();
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        isLoading = true;
        errorMessage = string.Empty;
        StateHasChanged();

        try
        {
            var result = await ManagementService.GetAllUsersAsync();

            if (result.Success)
            {
                users = result.Data ?? new List<UserResponseDto>();
                FilterUsers();
            }
            else
            {
                errorMessage = result.Message ?? "Failed to load users";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
            Console.Error.WriteLine(ex);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void FilterUsers()
    {
        var usersToDisplay = users.Where(u => u.Id != currentUserId).ToList();

        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredUsers = usersToDisplay
                .Skip((currentPage - 1) * pageSize)
                .Take(pageSize)
                .ToList();
        }
        else
        {
            var term = searchTerm.ToLower();
            filteredUsers = usersToDisplay
                .Where(u =>
                    u.Name?.ToLower().Contains(term) == true 
                    // ||
                    // u.Email?.ToLower().Contains(term) == true ||
                    // u.Department?.ToLower().Contains(term) == true ||
                    // u.Position?.ToLower().Contains(term) == true ||
                    // u.Roles.Any(r => r.ToLower().Contains(term))
                )
                .Skip((currentPage - 1) * pageSize)
                .Take(pageSize)
                .ToList();
        }
    }
    private async Task SearchUsers()
    {
        currentPage = 1;
        FilterUsers();
        StateHasChanged();
    }

    private async Task HandleApiError(HttpResponseMessage response)
    {
        if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            errorMessage = "Session expired. Redirecting to login...";
            StateHasChanged();
            await Task.Delay(1500);
            await ((JwtAuthenticationStateProvider)AuthStateProvider).NotifyUserLogout();
            Navigation.NavigateTo("/login", true);
            return;
        }

        try
        {
            var errorResult = await response.Content.ReadFromJsonAsync<OperationResult>();
            errorMessage = errorResult?.Message ?? $"Error: {response.StatusCode}";
        }
        catch
        {
            errorMessage = await response.Content.ReadAsStringAsync();
        }
    }

    private void EditUser(string userId)
    {
        Navigation.NavigateTo($"/admin/edit-user/{userId}");
    }

    private async Task ApproveUser(string userId)
    {
        // if (!await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to approve this user?"))
        //     return;

        isLoading = true;
        errorMessage = string.Empty;
        StateHasChanged();

        try
        {
            var result = await ManagementService.ApproveUserAsync(userId);
            Console.WriteLine($"User {userId} approved Enterrrrrrrrrrr.");
            Console.WriteLine($"Result received - Success: {result.Success}, Message: {result.Message ?? "null"}");

            if (result.Success)
            {
				Console.WriteLine($"User {userId} approved successfully.");
                // Show snackbar with correct syntax
                Snackbar.Add("User approved successfully !!", Severity.Success);

                // Optimistically update the local user object
                var user = users.FirstOrDefault(u => u.Id == userId);
                if (user != null)
                {
                    user.IsApproved = true;
                }

                // Force UI update
                // StateHasChanged();

                // // Optional: Still refresh from server to ensure consistency
                // await LoadUsers();
                Navigation.NavigateTo($"/admin/users");

            }
            else
            {
                errorMessage = result.Message ?? "Failed to approve user";
                Snackbar.Add(errorMessage, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to approve user: {ex.Message}";
            Snackbar.Add(errorMessage, Severity.Error);
            Console.Error.WriteLine(ex);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task DeleteUser(string userId)
    {
        // Uncomment if you want a JS confirmation dialog
        // if (!await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this user? This action cannot be undone."))
        //     return;

        isLoading = true;
        errorMessage = string.Empty;
        StateHasChanged(); // Force UI update for loading state

        try
        {
            var result = await ManagementService.DeleteApplicationUserAsync(userId);

            if (result.Success)
            {
                await LoadUsers(); // Refresh the user list
                Snackbar.Add("✅ User deleted successfully!", Severity.Success);
            }
            else
            {
                errorMessage = result.Message ?? "Failed to delete user";
                Snackbar.Add($"❌ {errorMessage}", Severity.Error); // Show error in Snackbar
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete user: {ex.Message}";
            Snackbar.Add($"⚠️ {errorMessage}", Severity.Warning); // Show exception in Snackbar
            Console.Error.WriteLine(ex); // Log to console (or use ILogger)
        }
        finally
        {
            isLoading = false;
            StateHasChanged(); // Update UI after operation
        }
    }

    private async Task OpenAddUserDialog()
    {
        var options = new DialogOptions
        {
            CloseButton = true,
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<AddUserDialog>("Add New User", options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is bool success && success)
        {
            await LoadUsers();
        }
    }

    private Color GetRoleColor(string role)
    {
        return role.ToLower() switch
        {
            "admin" => Color.Error,
            "manager" => Color.Warning,
            "user" => Color.Info,
            _ => Color.Default
        };
    }
}

