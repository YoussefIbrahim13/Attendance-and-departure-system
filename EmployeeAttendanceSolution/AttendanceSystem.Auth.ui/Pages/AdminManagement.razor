@page "/admin/users"
@using System.Text.Json
@attribute [Authorize(Roles = "Admin")]

@inject HttpClient Http
@inject NavigationManager Navigation
@inject ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider

<h3>User Management</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (isLoading)
{
    <div class="text-center my-4">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (users == null)
{
    <p>Loading users...</p>
}
else
{
    <div class="mb-3">
        <button class="btn btn-primary" @onclick="ShowAddUserModal" disabled="@isLoading">
            Add New User
        </button>
    </div>

    <table class="table table-striped">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Department</th>
                <th>Position</th>
                <th>Status</th>
                <th>Roles</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in users)
            {
                <tr>
                    <td>@user.Name</td>
                    <td>@user.Email</td>
                    <td>@user.Department</td>
                    <td>@user.Position</td>
                    <td>
                        @if (user.IsApproved)
                        {
                            <span class="badge bg-success">Approved</span>
                        }
                        else
                        {
                            <span class="badge bg-warning">Pending</span>
                        }
                    </td>
                    <td>@string.Join(", ", user.Roles)</td>
                    <td>
                        <button class="btn btn-sm btn-info" @onclick="() => EditUser(user.Id)" disabled="@isLoading">
                            Edit
                        </button>
                        @if (!user.IsApproved)
                        {
                            <button class="btn btn-sm btn-success ms-1" @onclick="() => ApproveUser(user.Id)" disabled="@isLoading">
                                Approve
                            </button>
                        }
                        <button class="btn btn-sm btn-danger ms-1" @onclick="() => DeleteUser(user.Id)" disabled="@isLoading">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- Add User Modal -->
@if (showAddModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Add New User</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseAddUserModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@newUser" OnValidSubmit="HandleAddUser">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <InputText class="form-control" @bind-Value="newUser.Name" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <InputText class="form-control" @bind-Value="newUser.Email" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            <InputText type="password" class="form-control" @bind-Value="newUser.Password" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Department</label>
                            <InputText class="form-control" @bind-Value="newUser.Department" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Position</label>
                            <InputText class="form-control" @bind-Value="newUser.Position" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Role</label>
                            <select class="form-select" @bind="selectedRole">
                                <option value="User">User</option>
                                <option value="Manager">Manager</option>
                                <option value="Admin">Admin</option>
                            </select>
                        </div>

                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary" disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                }
                                Save
                            </button>
                            <button type="button" class="btn btn-secondary" @onclick="CloseAddUserModal" disabled="@isLoading">
                                Cancel
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<UserResponseDto> users = new();
    private bool showAddModal = false;
    private UserCreateDto newUser = new();
    private string selectedRole = "User";
    private string errorMessage = string.Empty;
    private bool isLoading;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var response = await Http.GetAsync("api/Management/GetAllUsers");

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<OperationResult<List<UserResponseDto>>>();

                if (result?.Success == true)
                {
                    users = result.Data ?? new List<UserResponseDto>();
                }
                else
                {
                    errorMessage = result?.Message ?? "Failed to load users";
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                await HandleUnauthorizedResponse();
            }
            else
            {
                errorMessage = await GetErrorMessage(response);
            }
        }
        catch (HttpRequestException httpEx) when (httpEx.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            await HandleUnauthorizedResponse();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load users: {ex.Message}";
            Console.Error.WriteLine(ex);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleUnauthorizedResponse()
    {
        errorMessage = "Session expired. Redirecting to login...";
        StateHasChanged(); // Update UI immediately

        await Task.Delay(1500); // Give user time to see the message
        await ((JwtAuthenticationStateProvider)AuthStateProvider).NotifyUserLogout();
        Navigation.NavigateTo("/login", true);
    }

    private async Task<string> GetErrorMessage(HttpResponseMessage response)
    {
        try
        {
            return await response.Content.ReadAsStringAsync();
        }
        catch
        {
            return $"Error: {response.StatusCode}";
        }
    }

    private void ShowAddUserModal()
    {
        newUser = new UserCreateDto();
        selectedRole = "User";
        showAddModal = true;
    }

    private void CloseAddUserModal()
    {
        showAddModal = false;
    }

    private async Task HandleAddUser()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/Management/AddApplicationUser?roleName={selectedRole}",
                newUser);

            if (response.IsSuccessStatusCode)
            {
                await LoadUsers();
                showAddModal = false;
            }
            else
            {
                errorMessage = await GetErrorMessage(response);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to add user: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ApproveUser(string userId)
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var response = await Http.PostAsync(
                $"api/Management/approve/{userId}",
                null);

            if (response.IsSuccessStatusCode)
            {
                await LoadUsers();
            }
            else
            {
                errorMessage = await GetErrorMessage(response);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to approve user: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void EditUser(string userId)
    {
        Navigation.NavigateTo($"/admin/edit-user/{userId}");
    }

    private async Task DeleteUser(string userId)
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var response = await Http.DeleteAsync(
                $"api/Management/DeleteApplicationUser/{userId}");

            if (response.IsSuccessStatusCode)
            {
                await LoadUsers();
            }
            else
            {
                errorMessage = await GetErrorMessage(response);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete user: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}