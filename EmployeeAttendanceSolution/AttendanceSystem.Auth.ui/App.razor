

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData"
                                DefaultLayout="@typeof(MainLayout)"
                                NotAuthorized="@NotAuthorized">
                <Authorizing>
                    <div class="auth-loading">
                        <p>Checking authentication status...</p>
                        <div class="spinner"></div>
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="not-found">
                    <h1>Page Not Found</h1>
                    <p>Sorry, there's nothing at this address.</p>
                    <NavLink href="/" class="btn btn-primary">Return Home</NavLink>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    [Inject]
    private ISessionStorageService _sessionStorage { get; set; } = null!;
    [Inject]
    private SessionValidationService SessionValidator { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        await SessionValidator.ValidateSession();
    }

    private RenderFragment NotAuthorized(AuthenticationState context) => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "not-authorized");

        builder.OpenElement(2, "h1");
        builder.AddContent(3, "Not Authorized");
        builder.CloseElement();

        builder.OpenElement(4, "p");
        builder.AddContent(5, "You don't have permission to access this resource.");
        builder.CloseElement();

        if (!context.User.Identity.IsAuthenticated)
        {
            builder.OpenComponent<NavLink>(6);
            builder.AddAttribute(7, "href", "/login");
            builder.AddAttribute(8, "class", "btn btn-primary");
            builder.AddContent(9, "Login");
            builder.CloseComponent();
        }
        else
        {
            builder.OpenComponent<NavLink>(10);
            builder.AddAttribute(11, "href", "/");
            builder.AddAttribute(12, "class", "btn btn-secondary");
            builder.AddContent(13, "Return Home");
            builder.CloseComponent();
        }

        builder.CloseElement();
    };
}