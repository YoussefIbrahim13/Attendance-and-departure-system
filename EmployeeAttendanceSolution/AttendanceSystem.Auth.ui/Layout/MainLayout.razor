@inherits LayoutComponentBase
@using MudBlazor

<!-- Required Providers -->
<MudThemeProvider @bind-IsDarkMode="_isDarkMode" Theme="MyCustomTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

    <!-- Top App Bar -->
    <MudAppBar Elevation="4" Dense="true" Class="px-4">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@DrawerToggle" />
        <MudText Typo="Typo.h6" Class="ml-2">Attendance System</MudText>

        <MudSpacer />

        <MudToggleIconButton @bind-Toggled="_isDarkMode"
                             Icon="@Icons.Material.Filled.DarkMode"
                             ToggledIcon="@Icons.Material.Filled.WbSunny"
                             Color="Color.Inherit"
                             ToggledColor="Color.Warning"
                             Class="mr-2" />
    </MudAppBar>

    <!-- Side Drawer -->
    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" ClipMode="DrawerClipMode.Always" Class="mt-appbar">
        <NavMenu />
    </MudDrawer>

    <!-- Page Content -->
    <MudMainContent Class="mt-appbar p-4">
        @Body
    </MudMainContent>

</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode;

    private void DrawerToggle() => _drawerOpen = !_drawerOpen;

    MudTheme MyCustomTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Dark = Colors.Gray.Lighten3,
            Primary = "#1976d2",
            Secondary = "#388e3c",
            AppbarBackground = "#1565c0",
            Background = Colors.Gray.Lighten5,
            LinesDefault = Colors.Gray.Lighten2,
            Surface = "#ffffff",
            TextPrimary = "rgba(0,0,0,0.87)",
            TextSecondary = "rgba(0,0,0,0.6)",
            ActionDefault = Colors.Blue.Lighten4,
            Divider = Colors.Gray.Lighten2,
            DrawerBackground = "#ffffff",
            OverlayLight = "rgba(255,255,255,0.5)"
        },
        PaletteDark = new PaletteDark()
        {
            Primary = Colors.Blue.Lighten1,
            Secondary = Colors.Teal.Accent4,
            AppbarBackground = "#0d47a1",
            Background = "#121212",
            Surface = "#1e1e1e",
            DrawerBackground = "#1a1a1a",
            TextPrimary = "rgba(255,255,255,0.87)",
            TextSecondary = "rgba(255,255,255,0.6)",
            ActionDefault = Colors.Gray.Darken3,
            Divider = "rgba(255,255,255,0.12)",
            OverlayDark = "rgba(0,0,0,0.7)",
            HoverOpacity = 0.08,
            GrayDefault = "#757575"
        }
    };
}
